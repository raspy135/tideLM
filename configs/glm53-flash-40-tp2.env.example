# GLM-5.3-Flash 4 bpw on TWO DGX Sparks (TP=2): the TP=1 profile's model (configs/glm53-flash-40-tp1.env.example)
# with every routed expert resident - each rank holds its half of all 12,096 (gate / up by their
# intermediate columns, down by its hidden ones, as GLM-5.3's pair splits them), so nothing is read
# from disk and residency, hot reads and adaptation are off. The pair holds 4bpw whole with the 1M
# context unchanged (76.5 GB of experts a rank for 3.5bpw's 66.8) and decodes 2-5% slower than 3.5bpw
# (docs/glm-flash.md). Not tuned: at TP=2 the model fits whole, and other engines serve that case.
# Image input is one box's only (the tower is not split): off here.
# Start: cp configs/glm53-flash-40-tp2.env.example .env.glm53-flash-40-tp2, edit the paths, then
# scripts/tide.sh start .env.glm53-flash-40-tp2    Stop: scripts/tide.sh stop
#
# Setup: the TP=1 setup's dense dir at the same path on both nodes, and each rank's pack re-sliced
# from the one-box pack (no Hub; ~78 GB a rank), rank 1's copied to the peer:
#   uv run --no-project --with numpy python tools/glm_pack_exl3.py --from-pack <packs dir>/glm-flash-40-r0of1.bin \
#       --world 2 --rank R --out <packs dir>/glm-flash-40-rRof2.bin --verify 32       # R = 0 here, 1 for the peer
PEER=you@10.0.0.2
GLM_MODEL_DIR=/home/you/models/GLM-5.3-Flash-4bpw-dense
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash
# the model's own 1M (max_position_embeddings 1,048,576; no RoPE), each of two lanes at once: a
# 2M-position KV pool, ~14.3 GB a rank (whole on each rank), where one box spends that memory on experts
GLM_MAX_SEQ=1048576
GLM_KV_TOKENS=2097152
# requests served at once over one paged KV pool (KDA's state and its snapshots: half the heads a rank)
GLM_LANES=2
GLM_LANE_CHUNK=1024
GLM_KV=fp8
# whole on each rank: the position split is GLM-5.3's attention only (the engine refuses it here)
GLM_KV_SPLIT=0
# a memory budget in 3-bit records of a rank's half (4.74 MB each; this checkpoint's are all 4-bit,
# 6.3 MB): all 12,096 experts (76.5 GB a rank) fit in 16,400, the device at 95.9 GiB with the 2M pool
GLM_SLOTS=16400
GLM_FLASH_DENSE=fp8
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/glm-flash-packs
GLM_EXL3_PACK=/packs/glm-flash-40-r{rank}of2.bin
GLM_HEAD=exl3
GLM_KVB_FP8=1
GLM_EMBED_8BIT=int8
GLM_CHUNK=2048
GLM_PREFILL_REDUCE=bf16
# the routing history: its own state file (never GLM-5.3's or TP=1's), seeded at first boot from GLM_STATS_DB
RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/glm-flash-40-tp2-stats.npz
# the bundled seed, read only when the state file does not exist yet: v1 is a day of serving on the
# development box (2.9M routed rows: chat, benches, long-prompt tests; profiles/glm53-flash-history-v1.json).
# v0 (150K tokens of this repo's sources, prefill only) placed a 69% residency over 74.6% of that
# traffic's routed weight against 84.2% placed by the traffic itself. Without a seed, residency starts
# uniform and the output degrades (docs/glm-flash.md). To start over from it: README, "Resetting the
# routing history".
GLM_STATS_DB=/app/profiles/glm53-flash-history-v1.npz
# the disk prefix store holds KV rows, not KDA's state: off (the engine skips it for this model)
GLM_PREFIX_DISK=0
# MTP as at TP=1 (its measurement there)
GLM_MTP=1
GLM_MTP_DEPTH=7
GLM_MTP_CAL=0.36
GLM_MTP_DYN=0.9
GLM_COPY=1
GLM_LOOKUP=8
# every expert resident: nothing to adapt or read
GLM_ADAPT=0
GLM_HOT=0
GLM_HOT_ASYNC=0
# (GLM_HOT_RESCUE, the TP=1 profile's inline reads, needs hot reads: nothing to rescue here)
GLM_BG=0
GLM_REASONING_EFFORT=low
GLM_DEFAULT_MAX_TOKENS=32768
# image input: one box's only (GLM_VISION=1 refuses to start on the pair)
GLM_VISION=0
