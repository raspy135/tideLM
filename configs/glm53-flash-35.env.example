# GLM-5.3-Flash on ONE DGX Spark: Mia's AI Lab's EXL3 3.5bpw (Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw,
# rev 6f0cbf4a) with its non-expert weights served as FP8 (32 x 32 block scales) and ~67% of the
# routed experts resident, the rest read on demand from one pack. No PEER: one box.
#
# Setup (docs/glm-flash.md): ~160 GB of disk, nothing else downloaded
#   python3 tools/glm_fetch_dense.py --repo Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw --revision 6f0cbf4a4f1b226a20f90d715e9040a7359937f9 \
#       --out <dense dir>                                                   # 23 GB, the non-expert tensors
#   uv run --no-project --with numpy python tools/glm_pack_exl3.py --world 1 --resume --verify 64 \
#       --repo Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw --revision 6f0cbf4a4f1b226a20f90d715e9040a7359937f9 \
#       --out <packs dir>/glm-flash-35-r0of1.bin                            # 137 GB, straight from the Hub
GLM_MODEL_DIR=/home/you/models/GLM-5.3-Flash-3.5bpw-dense
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash
GLM_MAX_SEQ=327680
# requests served at once over one paged KV pool (each lane: ~0.45 GB of KDA state, ~0.15 GB of rollback rows)
GLM_LANES=2
GLM_LANE_CHUNK=1024
GLM_KV=fp8
GLM_KV_SPLIT=0
# a memory budget in 3-bit records at Flash's dims (9.47 MB each): 9400 = 89 GB, ~8,100 experts
GLM_SLOTS=9400
GLM_FLASH_DENSE=fp8
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/glm-flash-packs
GLM_EXL3_PACK=/packs/glm-flash-35-r{rank}of1.bin
GLM_HEAD=exl3
GLM_KVB_FP8=1
GLM_EMBED_8BIT=int8
GLM_CHUNK=2048
GLM_PREFILL_REDUCE=bf16
# the routing history: its own state file (never GLM-5.3's), seeded at first boot from GLM_STATS_DB
RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/glm-flash-stats.npz
GLM_STATS_DB=/home/you/tidelm-rust-state/glm-flash-history-v0.npz
# the disk prefix store holds KV rows, not KDA's state: off (the engine skips it for this model)
GLM_PREFIX_DISK=0
GLM_MTP=1
GLM_MTP_DEPTH=3
GLM_COPY=1
GLM_ADAPT=1
GLM_ADAPT_EVERY=200
GLM_ADAPT_PREFILL_SWAPS=512
GLM_ADAPT_DECODE_SWAPS=256
GLM_HOT=1
GLM_HOT_KEEP=32
GLM_HOT_ASYNC=0
GLM_REASONING_EFFORT=low
GLM_DEFAULT_MAX_TOKENS=32768
# image input: the checkpoint's vision tower (1.13 GB) loaded on demand into expert slots lent for
# the request, so text-only traffic keeps the memory for experts; up to this many image tokens a
# request (one a 28 x 28 pixel cell; the processor's own cap is 8000 an image)
GLM_VISION=1
GLM_VISION_MAX_TOKENS=8000
