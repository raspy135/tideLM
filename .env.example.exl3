# ===========================================================================================
# EXL3 profile (the default): routed experts from the 2.9 bpw EXL3 pack (build it once:
# scripts/exl3-packs.sh).
# Same image, scripts and settings as .env.example.fp4 except EXPERT_FORMAT.
# Copy to .env and edit; to switch profiles copy the other file, dual-down.sh + dual-up.sh.
# ===========================================================================================
# --- Model and API ---
# Checkpoint directory on each host; both nodes need a local copy.
MODEL_DIR=/path/to/models/DeepSeek-V4.1-Flash
# Python executable for native (non-container) launches.
PYTHON=python3
# Model name clients send in API requests.
SERVED_MODEL_NAME=deepseek
# Listen locally only; use a trusted interface IP for remote clients. No API auth.
HOST=127.0.0.1
PORT=8000
# Hugging Face download token, if needed. Never put a real token in this template.
HF_TOKEN=

# --- Context and generation ---
# Context allocation including the answer: 524288 = 512K tokens.
# This is a capacity setting, not a full-length quality validation.
MAX_SEQ=524288
DEFAULT_THINKING=off
DEFAULT_EFFORT=75
# Sparse attention entries per query (checkpoint: 512). Experimental; quality unmeasured.
# Restart both ranks together. Set 512 to restore checkpoint attention width.
DSV41_INDEX_TOPK=1024
# Enable speculative decoding with the checkpoint's draft model.
SPEC=1
# Acceptance-window depth 3/5 when confidence is disabled.
# For fixed depth, set CONFIDENCE=0, remove DYNAMIC, and set DSV41_BLOCK=3.
DSV41_BLOCK_DYNAMIC=3,5
# Optional per-step depth 1/3/5 from confidence and measured cost at every temperature.
# Sampling extends only a selected draft prefix; greedy uses whole-block lookahead.
# Requires DSV41_BLOCK=5 or unset. Set 0 to use adaptive 3/5 for every request.
DSV41_BLOCK_CONFIDENCE=0
# Decode experiments: qualify both ranks before enabling. All support sampling.
DSV41_LOOKUP_DRAFT_ENABLED=0
DSV41_LOOKUP_DRAFT_NGRAM=16
DSV41_DRAFT_BYPASS=0
# Optional CUDA graphs for prefill FFN blocks; attention/Engram stay eager.
# Requires resident FP4 TP, fixed routing and concurrency 1. See docs/prefill-cuda-graphs.md.
DSV41_PREFILL_GRAPHS=0
# Experimental selective streaming during prefill. Off: the small pilot showed no quality gain.
# Requires a calibrated profile, concurrency 1, PREFIX_CACHE=0, PREFIX_DISK=0 and PREFILL_GRAPHS=0.
# See docs/critical-prefill.md. Output norm estimates are a proxy, not answer-loss measurements.
DSV41_CRITICAL_PREFILL=0
DSV41_CRITICAL_PROFILE=
DSV41_CRITICAL_SHARE=0.25
DSV41_CRITICAL_PER_LAYER=1
DSV41_CRITICAL_BUDGET=8
# Concurrent requests (docs/concurrency.md) batch native FP4 experts only; EXL3 keeps 1.
DSV41_MAX_CONCURRENCY=1
# Image support.
DSV41_VISION=1
# TP2 only: peer keeps the tower on rank 1 and broadcasts image embeddings.
DSV41_VISION_MODE=peer

# --- Node networking ---
# Set the worker SSH address, head link IP, and link interface names.
# RoCE settings are detected separately on each node.
# Number of participating nodes; this profile requires two.
WORLD_SIZE=2
# Worker SSH destination, reachable from the head without a password prompt.
PEER=user@worker-ip
# Head node's IP on the direct node-to-node link.
MASTER_ADDR=head-ip
# Distributed rendezvous port, not the HTTP API port.
MASTER_PORT=29611
# Link interface used for GPU communication setup.
NCCL_SOCKET_IFNAME=link-interface
# Link interface used for coordination between nodes.
GLOO_SOCKET_IFNAME=link-interface
# Optional DGX Spark TP: dual rail for prefill, single rail for decode.
# Requires BOTH logical interfaces on the cabled port to have addresses (e.g.
# 10.0.0.1/24 + 10.0.1.1/24 on head; .2 on worker). See env.example for details.
# Validated with NCCL 2.29. Keep GID_INDEX unset for dynamic per-HCA selection.
# NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
# NCCL_IB_ADDR_FAMILY=AF_INET
# NCCL_IB_ADDR_RANGE=10.0.0.0/23
# NCCL_IB_ROCE_VERSION_NUM=2
# NCCL_IB_MERGE_NICS=0
# NCCL_CROSS_NIC=0
# DSV41_PREFILL_DUAL_RAIL=1
# Peer keepalive interval, in seconds.
DSV41_EP_PING_S=30

# --- Expert memory ---
# Engine-only starting budget, decimal GB per node; larger than the TTS profile.
# Slot capacity is checked; sustained peak-memory headroom is not yet validated.
# With TTS/other GPU services, start at ARENA_GB=90.2. The resident expert count follows the arena:
# every LRU slot less 16, capped at all 15,360 experts (FP4 at 92.3 GB ~9,795; EXL3 at 90.2 GB 13,498),
# logged at boot. DSV41_RESIDENT_EXPERTS=<n> pins an exact count for experiments only.
ARENA_GB=92.3
# Pruned residency must be on (0 < PRUNE_KEEP < 1) for dynamic allocation; with
# DSV41_DYNAMIC_EXPERTS=1 the arena, not this fraction, sets how many experts are resident.
PRUNE_KEEP=0.61
# Expert slots reserved for temporary streaming loads, outside the resident set.
# Eight is the supported minimum; ordinary adaptive loading does not use this ring.
TRANSIENT_SLOTS=8
# Minimum available-memory headroom required at arena allocation, in GB.
KEEP_FREE_GB=6

# --- Weight format and precision ---
# Routed experts from the EXL3 2.9 bpw pack: 6.67 MB a slot per node at TP2 (2-bit layers 18-22
# included), so the same ARENA_GB holds ~1.4x FP4's experts and the resident count follows. Dense,
# attention, head, shared experts, Engram and the DSpark drafter stay the native checkpoint's
# (MODEL_DIR). Decode uses the EXL3 CUDA kernels; /health must report "kernel": "exl3-cuda".
EXPERT_FORMAT=exl3
# The three DSpark draft blocks read their own attention + shared-expert matrices from the 4-bit
# EXL3 pack instead of the checkpoint's fp8 (pack: scripts/exl3-packs.sh, ~195 MB a rank;
# docs/exl3-draft.md). The draft only proposes and the verifier accepts the target's argmax, so
# greedy output is unchanged: two paired 24-prompt gates, -1.05 +- 0.37 ms/step, 24/24 identical,
# acceptance -0.007 +- 0.013. Needs DSV41_TP_DRAFT_ATTN=1 and the output layout. scripts/exl3-packs.sh
# builds the two draft packs (<models>/exl3-packs/exl3-draft-r{0,1}of2.safetensors) together with
# the expert packs; a missing pack refuses the boot. 0 restores the checkpoint's fp8 draft blocks.
DSV41_EXL3_DRAFT_DENSE=1
# The drafter's two heads over 40,960 listed ids a rank instead of all 129,280 (docs/draft-vocab.md):
# -1.06 +- 0.37 ms/step, acceptance -0.0013 +- 0.0013, outputs identical (proposals only). The file
# ships in the image; both ranks must read the same one (the boot guard compares its digest).
DSV41_DRAFT_VOCAB=/app/engine/draft_vocab_ranking_v1.txt
DSV41_DRAFT_VOCAB_ROWS=40960
# Lossy decode pruning of low-share routed experts (engine/expert_topp.py): per token and layer keep
# the shortest prefix of the top-6 by weight share reaching 0.90 (at least 3), router weights kept,
# dropped experts never read. Held-out NLL -0.0020 +- 0.0018 / -0.0004 +- 0.0034 nats (code /
# general, every position pruned); decode -2.22 ms/step FP4, -1.91 EXL3, acceptance unchanged
# (RESULTS.md 2026-10-11). Changes greedy output by near-tie flips. 0 or unset turns it off.
DSV41_EXPERT_TOPP=0.90
# Each node reads its own rank's pack with O_DIRECT from <MODEL_DIR's parent>/exl3-packs/
# exl3-experts-r<rank>of2.bin, which is where scripts/exl3-packs.sh puts it. Leave DSV41_EXL3_PACK
# unset: it names ONE file and the launcher sends it to both ranks (the boot then refuses the
# other rank's pack).
# Experimental hardware FP4 arithmetic path; keep 0 for the validated profile.
DSV41_FP4_DOT_SCALED=0
# Scaled (tensor-core FP4) arithmetic for prompt encoding and decoder replay only; decode keeps the
# native kernel. With SCALED_TILES (32-row blocks, bit-identical to the scaled default), 8K prefill
# -0.79 +- 0.14 s paired. A numerics change ~3x the chunk-size noise in logit KL, top-1 unchanged
# 9/9, decode acceptance -0.03 +- 0.03 (RESULTS.md 2026-10-08). Both ranks must match.
DSV41_FP4_PREFILL_DOT_SCALED=1
DSV41_FP4_PREFILL_SCALED_TILES=1
# Native CUDA BM=16 decode kernel; enabled by default after graph microbenchmark tuning.
# Prefill and unsupported shapes continue through Triton; see docs/gotchas.md.
DSV41_FP4_CUDA=1
# Faster CUDA reduction order; set 0 for the original order. Restart both ranks together.
DSV41_FP4_CUDA_RELAXED=1
# Experimental batched sampled verification: one GPU result transfer, different seeded RNG.
# Default off pending end-to-end validation; see docs/spec-sampling.md. Set identically on both ranks.
DSV41_BATCHED_VERIFY=0
# Keep dense checkpoint precision. Optional attn,wo_a re-quantization reduced the
# measured decode step by about 7%, but changes outputs; see docs/gotchas.md.
DSV41_DENSE_FP4=off
DSV41_FP4_DENSE_SPLIT=auto
# Decode attention: 0 = existing FP32 SIMT GEMMs, 1 = staged tensor-core GEMMs,
# 2 = staged GEMMs with BF16 key scratch (same key values, half the bytes). Changes
# accumulation order, not weight precision: 5.3 -> 2.0 ms of attention core per verify
# forward. With HC_KERNEL=1 and ROUTER_BF16=1: -7.3 ms/step, +9% tok/s, acceptance
# unchanged over 22 paired prompts (RESULTS.md 2026-10-08). Restart both ranks.
DSV41_ATTN_STAGED=2
# Hyper-Connection projection on the split-K fp32 kernel (tf32x3, ~1e-6 vs cuBLAS). Its earlier
# "acceptance drop" was one prompt; paired over 22 prompts acceptance is unchanged (RESULTS.md
# 2026-10-08, docs/gotchas.md). 0 restores the padded cuBLAS GEMM.
DSV41_HC_KERNEL=1
# Drafter head format. With DSV41_TP_DRAFT_HEAD=1, fp8 builds a separate draft-only vocab shard
# (+331 MB/rank) from the BF16 shard before packing; the verifier keeps the packed BF16 head.
DSV41_DRAFT_HEAD_FMT=fp8
# The Markov bias head (five M=1 GEMVs a draft pass against [129280, 256], 33 MB a read at TP2).
# off/bf16 keep the checkpoint's tensor; fp8/fp4 build a quantized copy. Measured: fp4 is NOT
# faster and costs -0.018 +- 0.014 accepted tokens/step (docs/gotchas.md 2026-10-11) -- both this
# head and the draft head above read at this box's plain-read ceiling, so leave this off.
DSV41_MARKOV_HEAD_FMT=off
# Lossless BF16 head packing: every logit bit-identical, ~146 MiB/rank saved, head
# projection ~30% faster (+2% decode in the RESULTS.md ABBA). Requires HEAD_FMT=bf16,
# HEAD_FP32=0, and DRAFT_HEAD_FMT=off/bf16 unless TP_DRAFT_HEAD=1. off keeps cuBLAS. Restart both ranks.
DSV41_HEAD_KERNEL=packed
# A separate quantized draft vocabulary shard; target head remains BF16. With DRAFT_MARKOV_TP=1:
# -1.79 +- 0.43 ms/step, acceptance +0.004 +- 0.005, +2.3% tok/s, 24/24 outputs identical
# (RESULTS.md 2026-10-08). Proposals only: verification still reads the target head.
DSV41_TP_DRAFT_HEAD=1
# Greedy DSpark Markov chain split by vocabulary half: each rank biases its own rows and exchanges
# one (max, id) pair per draft position instead of gathering 2.6 MB of logits. Same proposals.
DSV41_DRAFT_MARKOV_TP=1
# Split the drafter's attention projections across the pair instead of reading them in full on both
# ranks. Proposals only: 24/24 outputs identical, acceptance unchanged (2.718 both), -1.67 +- 0.33
# ms/step across two processes, +2.1% tok/s (RESULTS.md 2026-10-08). Needs TP_LINEAR_LAYOUT=output.
DSV41_TP_DRAFT_ATTN=1
# FP8 decode schedule: 32-wide output tiles, 256-wide K tiles. Bit-identical outputs (24/24, all
# decode shapes checked), -1.47 +- 0.56 ms/step, +1.8% tok/s (RESULTS.md 2026-10-08).
DSV41_FP8_DECODE_BLOCK_N=32
DSV41_FP8_DECODE_BLOCK_K=256
# Launch fusions at fp32 rounding: one-pass RMSNorm (4 launches -> 1) and the HC mixes' mean(x^2)
# folded into the split-K projection. -2.11 +- 0.63 ms/step, acceptance +0.023 +- 0.016, +4.0% tok/s
# over 22 paired prompts (RESULTS.md 2026-10-08). 0 restores the previous kernels.
DSV41_LEAN_RMS_FUSED=1
DSV41_HC_FRONT_FUSED=1
# Candidate shortlists for the Markov bias lose acceptance on this drafter (docs/gotchas.md).
DSV41_DRAFT_MARKOV_TOPK=0
DSV41_DRAFT_MARKOV_LOCAL=0
# Decode-sized all-gathers over the one-shot RoCE transport (tools/roce/): -5.5 ms/step, token hashes
# identical to NCCL (docs/decode-launches.md). Any setup failure falls back to NCCL by itself.
DSV41_COMM_BACKEND=roce
DSV41_ROCE_MAX_KB=256
DSV41_ROCE_HCAS=2
# error refuses at boot instead of falling back when the RoCE setup fails.
DSV41_ROCE_FALLBACK=nccl
# L2 prefetch of the next layer's weights during the MoE all-gather (~0.5-1 ms; 2 MB fits the window).
DSV41_L2PF_MB=2
# Hardware bulk-prefetch experiment; touch retains the measured baseline.
DSV41_L2PF_MODE=touch
# Pacing slowed the short RoCE-window microbenchmark; leave off.
DSV41_L2PF_PACE_GBPS=0
# Separate output-projection prefetch during attention, in MiB (0 = off; maximum 12).
DSV41_L2PF_ATTN_MB=4
# Per-layer QKV / shared-expert L2 prefetch: dense time drops 1-3 ms/forward but the forward does
# not get faster (touch waits, bulk competes for DRAM; docs/gotchas.md 2026-10-08). Leave at 0.
DSV41_L2PF_QKV_MB=0
DSV41_L2PF_SH_MB=0
# Exact six-way router gather/normalization fusion; does not alter expert selection.
DSV41_ROUTER_FUSED_TAIL=1
# Tensor-core router gate using the checkpoint's BF16 values with FP32 accumulation (not a
# BF16-output gate, which mis-routed 11% of picks in 2026-09). 3.2 -> 1.5 ms of router per
# verify forward; part of the 2026-10-08 paired A/B above. Costs ~150 MiB/rank. 0 = fp32 gate.
DSV41_ROUTER_BF16=1
# Experimental odd target widths: dynamic depths can include 2/4 (e.g. 2,4).
# Confidence mode gains depths 1..5; allow >=12 graphs when using all five depths.
DSV41_VERIFY_ODD=0
# At the graph-variant cap, release the whole shared pool; recapture on demand (0 = unbounded).
DSV41_GRAPHS_MAX=8
# Experimental remeasurement of stale confidence costs (steps, 0 = off).
# Only relevant with BLOCK_CONFIDENCE=1; ordinary depth 3/5 is still recommended.
DSV41_CONF_COST_REFRESH=0
# Optional: serve the abliterated attention output projection (layers 10-35) from a Keys overlay
# instead of the checkpoint's, applied at load -- no copy of the 510 GB tree, and the stock tree is
# never written (engine/ablit.py). The file is drowzeys/DeepSeek-V4.1-Flash-Abliterated-Cybersecurity-
# Unleashed's wo_b_l10_35.safetensors (~1.1 GB, the native fp8 e4m3 + e8m0 format), gated on HF:
# accept the terms on the model page, then `hf download`. Output-changing by design; every other
# tensor (experts, Engram, MTP/DSpark, vision) stays stock. Both ranks must point at the same file
# -- its digest is in the boot guard.
# Docker: put the identical overlay under the host models directory on BOTH nodes;
# use its /models container path here. Native launches use the host absolute path.
# DSV41_ABLIT_WOB=/models/dsv41-wo-b-ablit/wo_b_l10_35.safetensors
# Remove/empty this setting and restart both ranks to restore stock projections.
# Memoize the fp8->bf16 dequant on the prefill dense path. Bit-identical, but holds ~10 GiB on
# the 90 GB/keep 0.61 profile, so it is left off; enable only with the memory headroom.
DSV41_DENSE_DEQUANT_CACHE=0

# --- Prefill performance ---
# Tokens per chunk. 1024 gives finer cache boundaries; 2048 reduces dispatch overhead.
# 2048 rows (TF uses the same). Adaptive sizing (DSV41_PREFILL_ADAPT) drops to 1024/512/256 under
# memory pressure. 4096 measured slower. A chunk longer than 4096 - 128 also needs DSV41_RING.
DSV41_PREFILL_CHUNK=2048
# Choose a smaller chunk once per request using the tighter node's available RAM.
# Engram read-ahead shares the chosen boundaries; image spans remain indivisible.
# A scratch estimate, not an OOM guarantee. Keep the watchdog enabled.
DSV41_PREFILL_ADAPT=1
DSV41_PREFILL_FLOOR_GIB=4
DSV41_PREFILL_MIN_ROWS=256
DSV41_PREFILL_ROW_MIB=2
# Use the fused prefill attention implementation.
DSV41_PREFILL_FUSED_ATTN=1
# Prefill kernels (docs/gotchas.md 2026-10-08). INDEXED is exact; HC_PREFILL_FUSED and INDEX_FUSED
# change numerics at the level adaptive chunk sizing already does. Cold 8K 7.9 -> 5.8 s together.
DSV41_PREFILL_ATTN_INDEXED=1
DSV41_HC_PREFILL_FUSED=1
DSV41_INDEX_FUSED=1
# Attention kernel head tile size; leave at the tuned value.
DSV41_PREFILL_ATTN_BLOCK_H=16
# Attention kernel key tile size; leave at the tuned value.
DSV41_PREFILL_ATTN_BLOCK_N=32
# Experimental EP communication overlap; keep 0 with TP.
DSV41_PREFILL_EP_OVERLAP=0

# --- Decode performance ---
# Run the replicated shared expert on a side CUDA stream, overlapping routed experts.
DSV41_DECODE_SHARED_OVERLAP=1

# --- Prefix and context caching ---
# RAM reuse remains enabled with dynamic expert allocation; restart clears it.
DSV41_PREFIX_CACHE=1
DSV41_SWA_REPLAY=1
# Chunk-boundary snapshots retained in addition to the full input boundary.
DSV41_PREFIX_SNAPSHOTS=16
# Disk and post-response caches must stay disabled with DYNAMIC_EXPERTS=1.
# Disk persistence is a separate legacy-mode feature, not RAM prefix reuse.
DSV41_PREFIX_DISK=0
# Used only if disk caching is enabled in a compatible mode: 300 s between saves.
# Inactive with PREFIX_DISK=0; RAM prefixes still update every turn.
DSV41_PREFIX_DISK_MIN_INTERVAL_S=300
# Pack already-quantized history; window caches and index keys stay BF16.
DSV41_PACKED_KV=1
# Per-node disk cache limit in GB; least-recently-used bundles are evicted.
DSV41_PREFIX_DISK_GB=20
# 1 requires the same expert selection; 0 allows reuse after adaptation changes it.
DSV41_PREFIX_DISK_STRICT=0
# Prepare plain-text answers as prefixes after delivery; skips thinking/tools/vision.
DSV41_PREFIX_RESPONSE=0

# --- Tensor parallelism ---
# Split each resident routed expert across the two nodes.
DSV41_TP_EXPERTS=1
# Split main-model shared-expert weights across nodes.
DSV41_TP_DENSE=1
# Split attention projections across nodes; context caches remain replicated.
DSV41_TP_ATTN=1
# Split the output vocabulary projection across nodes.
DSV41_TP_HEAD=1
# Split draft experts, saving 3.36 GiB/node; required for the arena budget above.
DSV41_TP_DRAFT_EXPERTS=1
# Split input embeddings, saving 0.62 GiB/node; required for the arena budget above.
DSV41_TP_EMBED=1
# Automatic combine strategy for the legacy intermediate layout; leave at auto.
DSV41_TP_EXPERT_REDUCE=auto
# Preserve complete expert down-projection dot products; keep output for quality.
DSV41_TP_EXPERT_LAYOUT=output
# Preserve complete dense output-projection dot products; keep output for quality.
DSV41_TP_LINEAR_LAYOUT=output

# --- Adaptive expert loading ---
# How far one request moves the resident expert set: off, low, medium, high, max
# (demand half-life never / 40 / 20 / 10 / 5 requests), or a number in [0, 0.5).
# Higher follows a changing workload faster and swaps more experts per request; too high
# chases each prompt and raises the miss rate. Everything else is derived by the engine.
DSV41_ADAPT_SENSITIVITY=high
# Weight of the shipped routing trace, in requests. Lower lets this server's traffic win sooner.
DSV41_ADAPT_PRIOR=4
# Placement metric: frequency (default) or score (sum of pre-mask router scores).
# Score mode uses the learned cold-start seed when no local history exists.
DSV41_PRUNE_METRIC=score
DSV41_PRUNE_MISS=1
# How the shipped coding/general traces combine into the residency ranking: sum or max.
# (The fixed topic profiles were removed 2026-10-17; see docs/expert-profiles.md.)
# DSV41_PRUNE_RANK=sum
# Optional experimental allocation: exactly 40 integer counts, each >=6 and <=384,
# summing to ceil(PRUNE_KEEP*384)*40. Requires PRUNE_SELECT=uniform; blank keeps
# the usual equal budget. Both ranks guard the complete list at boot.
# DSV41_PRUNE_LAYER_COUNTS=
# Experimental immediate full routing in selected layers, for prefill AND decode.
# Uniform keep .61 needs TRANSIENT_SLOTS>=149 (160 fits the current 90.1 GB arena).
# Requires concurrency 1, native FP4 output TP, resident LUTs, and PREFIX_CACHE,
# PREFIX_DISK, PREFILL_GRAPHS all 0. Unset keeps the original resident path.
# DSV41_STREAM_LAYERS=
# Latest real user text only: full prefill routing, then promote/protect its
# strongest routed experts within each layer quota. Decode stays resident.
# One resident prefill rebuild after admission makes the first answer use the
# chosen residents too; bounded SWA replay must remain enabled.
# Text-only/concurrency 1; PRUNE_MISS=1; disable PREFIX_CACHE/DISK/RESPONSE and
# PREFILL_GRAPHS. Transient ring must fit every cold expert in one layer
# (149 at uniform .61, 159 with the 5% Mia layer discount). TP2 boot guarded.
DSV41_USER_PROMPT_STREAM=0
# Cold expert loads for latest-user streaming per request; 0 is unlimited.
# This does NOT limit normal prefill/decode/urgent/idle resident adaptation.
# Inactive with USER_PROMPT_STREAM=0. Once spent, use ordinary resident routing.
# Rank 0 selects cold experts by current user-row score mass; both TP ranks
# share the plan/budget. Transient hits present on both ranks spend no budget.
DSV41_USER_PROMPT_MAX_LOADS=100
# Share resident sectors across layers, including global startup selection.
# No fixed layer counts or discounts. Full discovery batches cold experts to
# fit TRANSIENT_SLOTS; only the routing top-k minimum (6) remains per layer.
# Supports resident prefill with USER_PROMPT_STREAM=0; decode LUT/masks stay fixed.
# Requires adaptive pruning + PRUNE_MISS, resident LUTs, no fixed
# profiles/layer streaming, and PREFIX_RESPONSE/PREFILL_GRAPHS both 0.
# PREFIX_CACHE=1 is supported with USER_PROMPT_STREAM=0: reuse historical RAM KV
# after expert swaps, as with the original adaptive policy. Streaming requires 0.
DSV41_DYNAMIC_EXPERTS=1
# Fresh score/request-history installs start from profiles/learned-experts-v1.npz.
# Existing local DBs always take precedence. 0 uses the original trace start.
DSV41_EXPERT_SEED=1
# Tested 3,4,5,6,7,15,16,17,18,19 recovered two selected failures but gave
# no gain on separate questions. This remains experimental, not a quality default.
# Diagnostic-only per-request masks; requires ALL 40 stream layers and all swaps off.
# Rank 0 alone reads JSON {"pruned_layers": [0]}, then both ranks apply its broadcast.
# DSV41_LAYER_ABLATION_FILE=results/layer-ablation-control.json
# Mid-answer adaptation pass every N output tokens (~0.2 s each); 0 turns only these off.
DSV41_ADAPT_DECODE_TOKENS=600
# Urgent decode-only miss check over the last ~30 output tokens: >10%, <=64 swaps,
# at least 150 tokens between attempts. 0 disables only this rolling trigger.
DSV41_ADAPT_URGENT=1
# Demand history survives restarts; private and separate from prompt/KV caches.
DSV41_PRUNE_DB=results/prune_demand_req_score.npz
# Legacy PRUNE_UNIT/HALFLIFE/PRIOR/SWAP thresholds are derived from ADAPT_* above;
# do not copy obsolete overrides from older .env files.
# Old request-unit score columns were not normalized and cannot seed score ranking.

# --- Engram disk reads ---
# Divide Engram table reads between nodes to reduce duplicate disk work.
DSV41_ENGRAM_ROW_SPLIT=1
# Native C++ gather for decode-sized (<=384 row) reads instead of the Python pool.
# Measured ~+6% decode at 512 tokens on the development pair; needs the mmap row path
# (on by default). Roll back with 0 on both nodes and restart together.
DSV41_ENGRAM_NATIVE=1
# O_DIRECT sector reads for prefill-sized Engram gathers (> 384 rows); decode keeps the memmap.
# Page-faulted prefill reads forced reclaim/compaction that stalled the GPU: cold 8K 358-545 ->
# 782-933 tok/s. All sizes (=1) cost decode +0.9 ms/step.
DSV41_ENGRAM_DIRECT=prefill
# Packed Engram row cache, total MiB per node, divided across its two tables.
# The second node gets a larger cache; these budgets leave more room for experts.
DSV41_ENGRAM_CACHE_MB=256
DSV41_ENGRAM_CACHE_MB_PEER=1024

# --- Request capture ---
# 0 = off; 1 = capture the next request. Captures contain private prompt data.
DSV41_CAPTURE_NEXT=0

# --- Computed prediction before prefill (on by default) ---
# Probe routing from the current prompt; no dictionary lookup or training bank.
# For 1-499 uncached tokens, discover the full suffix, load the selected experts,
# then rerun the suffix from the cached prefix. For 500+ tokens, use bounded excerpts.
# Full cache hits and vision skip. Normal adaptive learning and correction stay active.
# Set DSV41_PROBE_PREFILL=0 to disable discovery. Discovery and loading add latency;
# the excerpt 10% time target is telemetry, not a hard limit.
# Requires SWA replay. See docs/predictive-prefill.md.
