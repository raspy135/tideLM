# GLM-5.3 on two Sparks: copy to .env.muse (read by scripts/muse-up.sh). docs/glm53-plan.md.
# Checkpoint at the same path on both nodes.
MUSE_MODEL_DIR=/home/ryan/models/GLM-5.3-Quark-MXFP4-AttnFP8
PORT=8000
SERVED_MODEL_NAME=glm-5.3
# Context. The MLA latent cache is ~90 KB a token a rank (both ranks hold it): 32K ~3 GB.
MUSE_MAX_SEQ=32768
MUSE_CHUNK=1024
# Expert slots per rank (auto: MemAvailable less a 20 GB floor, 88% of the rest).
MUSE_SLOTS=auto
MUSE_RESERVE_GB=20
MUSE_MISS=substitute
# Resident set from tools/glm_trace.py (same path on both nodes); unset = a per-layer placeholder.
# MUSE_RESIDENT=/app/results/glm-trace-.../resident-7500.json
# MTP speculative decoding: drafts a round (0 = off).
MUSE_MTP=1
MUSE_MTP_DEPTH=3
# LM head: bf16 as published, or fp8 (halves the step's largest single read).
MUSE_HEAD=bf16
MUSE_DEFAULT_MAX_TOKENS=4096
