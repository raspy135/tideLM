# ---------------------------------------------------------------------------
# DeepSeek-V4.1-Flash on a single NVIDIA DGX Spark (GB10 / sm_121, 121 GiB unified)
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here is also overridable from the
# environment, so `PORT=8001 scripts/dual-up.sh` works without touching the file.
#
# This fork serves TWO DGX Sparks and has no single-box launcher: the engine is
# started with scripts/dual-up.sh (containers, one rank per box) and stopped with
# scripts/dual-down.sh. docs/install.md covers the host side.

# --- what to serve -------------------------------------------------------
# The full 510 GB checkpoint: 48 safetensors shards, `inference/`, `encoding/`
# and the tokenizer. Experts are streamed from here at run time, so this path
# must be on local NVMe -- not NFS, not overlayfs (O_DIRECT will not work).
# ./run.sh derives the container's bind mount from this (MODELS_DIR = its
# parent, MODEL_NAME = its basename).
MODEL_DIR=./models/DeepSeek-V4.1-Flash

# The interpreter that has torch (CUDA 13 / sm_121), triton, transformers,
# safetensors, numpy and sympy -- see docs/install.md for building one. Used by
# the tests and the profiling tools only; the container brings its own. A bare name is looked up on
# PATH, so `python3` works if that is already the right interpreter; point it at
# a venv (e.g. .venv/bin/python) otherwise.
PYTHON=python3

SERVED_MODEL_NAME=deepseek-v4.1-flash
HOST=127.0.0.1
PORT=8000

# --- engine shape --------------------------------------------------------
# KV cache + indexer slices are allocated for MAX_SEQ tokens up front, so this
# is a memory knob as much as a context knob. 32768 costs ~1 GB of the arena.
MAX_SEQ=32768
# Sparse attention entries per query; checkpoint default is 512. Quality unmeasured.
# Restart both ranks together; 512 restores checkpoint attention width.
DSV41_INDEX_TOPK=1024

# GB of resident FP4 expert arena (each expert is 18.8 MB, 384 per layer x 40
# layers = 288.8 GB total, so this is the hot set and everything else is a
# NVMe read). Empty = size it automatically from free memory at load time,
# which is the right default; set it only to pin a layout for an A/B.
ARENA_GB=

# Which experts the warm start pulls in, ranked by a measured routing trace
# (tools/expert_stats.py output). Without it the warm start falls back to
# (layer, expert) index order, which is a measurably worse hot set.
# Leave it EMPTY for auto: the container entrypoint then
# take the newest results/trace-*/stats/coverage.json in the checkout. Set it
# to a path only to pin one particular trace.
TRACE_STATS=

# --- thinking ------------------------------------------------------------
# V4.1's template is not binary: thinking on/off plus an effort budget 1-100
# rendered as a `Reasoning Effort: N` system prefix. These are the defaults for
# requests that say nothing; any request can override them (server/README.md).
DEFAULT_THINKING=off
DEFAULT_EFFORT=75

# Output-altering repetition heuristics are opt-in. The cycle breaker can ban valid
# nested JSON and repetitive code; leave disabled for ordinary use and quality tests.
DSV41_CYCLE_BREAK=0
DSV41_NO_REPEAT_NGRAM=0

# --- tool calling --------------------------------------------------------
# 1 = constrain decoding to the DSML tool-calls block with a grammar built from
# the request's own tool schemas (server/tool_grammar.py, needs xgrammar). The
# constraint starts when the model writes the calls marker and ends when the
# block closes, after which only the end-of-turn token is legal -- which is what
# keeps a drifting tool call from running to the output cap. Prose is never
# constrained and a request without tools never builds a grammar. 0 = sample
# freely and recover malformed calls with the tolerant parser in server/app.py.
# DSV41_TOOL_GRAMMAR=1   (default 0 until the end-to-end gates have run)
# Log the generated grammar (and the grammar that failed to compile, if any).
# DSV41_LOG_TOOL_GRAMMAR=0
# Log the raw text of a tool call the strict parser rejected.
# DSV41_LOG_TOOL_TEXT=0

# --- speculative decoding ------------------------------------------------
# 1 = use the checkpoint's MTP/DSpark layers to draft (lossless, the target
# verifies every drafted token). 0 = plain autoregressive decode, the A/B
# baseline and the first thing to turn off when debugging numerics.
SPEC=1
# Experimental batched sampled verification (temperature > 0). Same rejection rule, different
# random draw sequence; changes seeded completions. Both ranks must agree. See docs/spec-sampling.md.
DSV41_BATCHED_VERIFY=0

# --- guards --------------------------------------------------------------
# MemAvailable the launcher demands before it will load (GiB). 0 disables.
MIN_FREE_GIB=90

# --- dual spark (EP2; docs/dual-spark-plan.md) ----------------------------
# WORLD_SIZE=2 splits the routed experts by parity across two GB10 boxes over the
# ConnectX-7/RoCE link (engine/dist.py). Every other weight, the KV cache and the
# sampling stay replicated, so both ranks hold identical logits and the generation
# loops stay in lockstep with no per-step token traffic -- one fp32 all-reduce per
# MoE layer is the entire network cost. Unset/1 = the single-box recipe, unchanged.
# Requirements on BOTH boxes: the same checkout at the SAME path, the same .venv,
# the full 510 GB checkpoint on LOCAL NVMe (O_DIRECT never crosses the network),
# passwordless ssh from this box (the head) to PEER, and RoCE up on the link that
# will carry NCCL (check with: ibdev2netdev -- look for ACTIVE).
# WORLD_SIZE=1
# SSH target for rank 1. scripts/dual-up.sh launches the headless worker there,
# scripts/dual-down.sh tears it down, and the memory guard runs on both boxes
# before either container boots.
# PEER=user@10.0.0.2
# NCCL rendezvous address. Unset = derive this box's source address on the route to
# PEER (the direct-attach 200G interface when PEER is 10.0.0.x). Set it explicitly
# if the boxes talk over more than one link -- pin the fast one.
# MASTER_ADDR=10.0.0.1
# MASTER_PORT=29611
#
# NCCL interface + RoCE pins. Leave all four unset for the portable single-rail fallback:
# dual-up.sh pins the socket interface and derives the RoCE device and GID index PER NODE with
# scripts/roce_gid.sh. That per-node part is not a nicety -- the two Sparks here do
# not agree on GID indices (the RoCEv2/IPv4 entry is index 5 on 10.0.0.1 and index 6
# on 10.0.0.2, whose index 5 is an empty slot), and a wrong index does not degrade to
# sockets: NCCL fails the queue-pair transition outright with
#   ibv_modify_qp failed with 61 ... local GID index 5, local GID ::
# and the pair never forms. Setting NCCL_IB_GID_INDEX here overrides BOTH ranks with
# one value, which is exactly the bug -- do it only to reproduce one.
# NCCL_SOCKET_IFNAME=enp1s0f1np1
# GLOO_SOCKET_IFNAME=enp1s0f1np1
# NCCL_IB_HCA=rocep1s0f1
# NCCL_IB_GID_INDEX=
#
# DGX Spark full-port / dual-rail configuration. One physical QSFP port exposes two
# Ethernet/RoCE devices, each behind an independent PCIe Gen5 x4 path. Assign the second
# netdev an address on 10.0.1.0/24 on both nodes, then use both HCAs. Do NOT set
# NCCL_IB_GID_INDEX here: the one scalar index cannot safely represent multiple HCAs and its
# value moves across boots. NCCL 2.21+ selects each HCA's RoCEv2 GID dynamically inside /23.
# NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
# NCCL_IB_ADDR_FAMILY=AF_INET
# NCCL_IB_ADDR_RANGE=10.0.0.0/23
# NCCL_IB_ROCE_VERSION_NUM=2
# NCCL_IB_MERGE_NICS=1
# NCCL_CROSS_NIC=0
#
# TP2 phase-specific routing (validated on NCCL 2.29 / one GPU per Spark):
# keep both HCAs and the address range above, but leave the NICs unmerged so the
# default/decode communicator can retain only one physical rail. A separate
# communicator carries prefill attention/dense/expert/embedding/head and Engram
# collectives on both rails. Both communicators warm before sizing the arena.
# The explicit prefill flag determines routing, including short prefill chunks;
# CUDA decode/draft graphs keep the default single-rail communicator.
# NCCL_IB_MERGE_NICS=0
# DSV41_PREFILL_DUAL_RAIL=1
# Disable the mode AND select one NCCL_IB_HCA to restore an entirely single-rail run.
#
# Process-group timeout (s). This is also how long a half-dead pair takes to give up,
# so it is the worst-case hang a client can see if one rank dies without a word.
# DSV41_DIST_TIMEOUT_S=600

# --- dual spark in containers --------------------------------------------
# The container path is the recommended way to run the pair, for two reasons that
# have nothing to do with taste: the image carries python3-dev (Triton JIT-compiles
# its CUDA shim at RUN time and cannot start without Python.h -- neither Spark has
# it natively), and one image on both boxes removes engine/torch version skew, which
# EP2 punishes by wedging on a mismatched collective rather than by being wrong.
#
#   scripts/dual-build.sh     build once here, ship the SAME image id to PEER
#   scripts/dual-up.sh        start rank 0 here + rank 1 on PEER, wait for /health
#   scripts/dual-down.sh      stop both, wait for the pool to come back on both
#   G0_DOCKER=1 scripts/run_g0.sh   re-run the RoCE latency gate inside the image
#
# Image tag used by all of the above. dual-build.sh asserts both boxes end up on the
# identical image id, so do not `docker build` on the peer separately.
# IMAGE=deepseek-v41-flash-spark:local
# Container names (only matters if you run more than one pair on a box).
# NAME0=deepseek-v41-ep2-rank0
# NAME1=deepseek-v41-ep2-rank1
# Host directory holding the checkpoint DIRECTORY; it is bind-mounted at /models, and
# must be real local NVMe on BOTH boxes -- the engine reads experts with O_DIRECT,
# which overlayfs and network filesystems do not serve. Defaults to MODEL_DIR's parent.
# MODELS_DIR=$HOME/models

# --- concurrent requests (TP2 only; docs/concurrency.md) -------------------
# N lanes (2..8): requests queue, each prefills alone, and every decoding lane's verify block
# runs in ONE batched step, so the dense weights and any expert two lanes share are read once.
# Works with dynamic experts, probe prefill, dynamic depth and decode/urgent adaptation; refuses
# latest-user/layer streaming, critical prefill, prefill graphs, lookup draft and draft
# bypass. 1 = the single-request server, no lanes allocated.
# DSV41_MAX_CONCURRENCY=1
# Context of lanes 1..N-1 (lane 0 keeps MAX_SEQ; longer requests wait for it). Each extra lane
# costs ~0.25 GB at 32K: a fixed 0.18 GB window ring plus ~1.9 KB a context token.
# DSV41_LANE_MAX_SEQ=65536
# The engine takes the lanes and their graphs out of ARENA_GB (logged at boot; 1.89 GB for two
# lanes at 512K/64K). Override the per-lane graph allowance with a measured one, in GB:
# DSV41_LANE_RESERVE_GB=
# Release the batched graphs (~0.25 GB, inside the reserve) after this many single-lane steps in a
# row; 0 keeps them (each release costs the next concurrent pair a ~1-2 s recapture).
# DSV41_BATCH_IDLE_STEPS=0

# --- container only ------------------------------------------------------
# Registry namespace for the prebuilt image (ghcr.io/<owner>/deepseek-v41-flash-spark).
# GHCR_OWNER=0xbakeer
# Optional Hugging Face token for scripts/download-model.sh. The repo is public;
# a token only raises rate limits. Keep it in .env, never in env.example.
# HF_TOKEN=

# --- prefill / expert streaming knobs -----------------------------------
# These are read straight from the environment by the engine (not by the launcher),
# so `DSV41_PREFILL_CHUNK=512 scripts/dual-up.sh` works. The defaults are what the
# measured numbers in NOTES.md "Speed work" were taken with.
#
# Prefill chunk length. A prefill chunk touches ~370 of the 384 experts of every
# layer whatever its length, so the NVMe traffic of a prompt is roughly
# chunks x layers x 7 GB: quadrupling the chunk quarters it. Costs activation
# memory (~2.7 GB peak at 2048).
# DSV41_PREFILL_CHUNK=2048
# EP2 FP4 prefill: skip matrix products for the peer's zero expert.
# DSV41_PREFILL_SKIP_NULL=1
# All-resident EP2 prefill: fixed layer-local routing, no dynamic unique/indexing.
# DSV41_PREFILL_FIXED_ROUTING=1
# Read both Engram tables concurrently at chunk start, ahead of layers 1 and 14.
# DSV41_PREFILL_ENGRAM=1
# Window ring slots per layer; must stay above window_size + DSV41_PREFILL_CHUNK.
# DSV41_RING=4096
# Decoder SWA Bounded Replay (tech report 3.2.2): prefill runs layers 0..20 over
# the whole prompt and layers 21..39 over the last 128 tokens only. 0 = run all
# 40 layers over the prompt like the reference does (exact, ~3x slower TTFT on a
# 1.8k-token prompt).
# DSV41_SWA_REPLAY=1
# Expert reader: one task per expert on DSV41_IO_THREADS workers, each expert's
# two file runs cut into DSV41_READ_CHUNK_MB aligned pieces issued on
# DSV41_READ_THREADS workers (0 = do not split).
# DSV41_IO_THREADS=12
# DSV41_READ_THREADS=24
# DSV41_READ_CHUNK_MB=4
# Which slice of the traced corpus ranks the warm-start hot set: mixed | coding | general.
# DSV41_HOT_PROFILE=mixed
# Dense (non-routed-expert) projections re-quantized from the checkpoint's fp8
# (e4m3 + UE8M0 32x32 block scales) to fp4 (E2M1 codes + one UE8M0 scale per 32 K
# weights of a row, the routed experts' format) at load time, which is 0.531x the
# bytes: off | shared | attn | wo_a | any comma combination ("all" = all three).
# "shared" is the shared-expert FFN w1/w2/w3, "attn" is wq_a/wq_b/wkv/wo_b, "wo_a"
# is the [8, 1024, 4096] attention output LoRA on the grouped kernel. The indexer
# wq_b, the engram wkv and mtp.0.main_proj always stay fp8.
# Measured 2026-09-11 (RESULTS.md 3.2/3.3): "attn" is 19.1 -> 20.9 tok/s at +0.002 (code) /
# -0.035 (prose) nats held-out; "wo_a" adds 630 MB/step less to read; "shared" costs
# +0.015 / +0.065 nats and is left in fp8. Code default: off.
DSV41_DENSE_FP4=off
# Memoize the fp8->bf16 dequant on the prefill dense path (bit-identical). Off by default: it
# holds several GiB resident (measured ~10 GiB at arena 90 / keep 0.61), so enable only with
# the memory headroom. See .env.example.
DSV41_DENSE_DEQUANT_CACHE=0
# With a dense fp4 group enabled: run the fp4 kernel at prefill M too (kernel,
# default) or dequantize transiently and use cuBLAS (dequant), as the fp8 path does.
# DSV41_FP4_DENSE_PREFILL=kernel
# Activation dtype handed to the tensor cores by the dense fp4 kernel: 1 = fp16
# (what the routed-expert kernel does), 0 = bf16 (wider exponent range).
# DSV41_FP4_DENSE_F16=1

# --- the LM head's stored format. `head.weight` is [129280, 5120] and is read in full on every
# decode step, twice (the verify step and the DSpark draft). bf16 (the checkpoint's dtype, the
# default) is 1.324 GB per read; fp8 is e4m3 + one UE8M0 scale per 32x32 block, 0.663 GB; fp4 is
# E2M1 + one scale per 32 K weights of a row, 0.352 GB. Quantized once on the GPU at load.
# See NOTES.md 2026-09-11 for the measured loss and decode numbers. Keep the checkpoint's BF16
# head here: unlike the attention-only FP4 setting above, LM-head quantization is intentionally
# outside this quality-first serving profile.
DSV41_HEAD_FMT=bf16
# Above decode-sized M a quantized head dequantizes 16,384 vocabulary rows at a time and hands each
# block to cuBLAS (blocked, the default); `kernel` runs the decode kernel at every M instead.
# DSV41_HEAD_PREFILL=blocked

# Score sparse-attention index keys only through the smallest power-of-two context bucket that
# covers the current verify block.  This keeps decode cost proportional to used context rather
# than MAX_SEQ.  Set to 0 only for a full-cache performance/correctness A/B.
# DSV41_INDEX_BUCKETS=1

# Prefill indexer score reduction. The indexer's [chunk, context] score matrix is a pure ranking
# intermediate (masked_fill -> block amax -> topk), and the query axis is independent, so it can be
# reduced one ATTN_TILE query tile at a time. That drops the transient from T x context (2.1 GB of
# bf16 at 512k, 4.2 GB before DSV41_INDEX_SCORE_BF16) to ATTN_TILE x context (67 MB at 512k); the
# einsum tiles and the total top-k work are unchanged.  This is what makes 512k fit; it is not
# expected to move prefill speed much either way.  Both paths must select the same positions, and a
# per-tile topk can break a tie differently, so it is off until tools/test_prefix_invariance.py
# passes with it on, and the EP2 boot guard refuses a split pair.
# DSV41_INDEX_STREAM=0
# DSV41_INDEX_SCORE_BF16=1

# --- how many routed experts the router activates per token. The checkpoint stores 6 of 384
# (`n_activated_experts`), plus the layer's shared expert, which this switch does not touch. A
# smaller k keeps the highest gate logits, renormalizes the gate weights over the survivors exactly
# as the router already normalizes the six, and so touches fewer DISTINCT experts per verify block
# -- which is what sets the expert bytes a decode step reads. Measured 2026-09-11 (NOTES.md): k=5 is
# 0.84x the expert bytes and 8 ms off a 115 ms step, at +0.025 nats on held-out prose, which is
# above the +0.015 budget; k=4 is worse on both corpora. Unset = the checkpoint's 6.
# DSV41_TOPK=6
# The DSpark drafter's own router (top-3 of 128 per MTP block) is separate and is not affected.

# --- the DSpark verify block: one accepted token plus DSV41_BLOCK drafted ones. The checkpoint's
# DSpark head was trained at `dspark_block_size` = 5, which stays the default. Must be odd (the
# verify block, block + 1, has to be even: the ratio-2 key compressor groups the block's positions
# in pairs around one pending slot). A larger block amortizes the same 40 layers of routed-expert
# reads over more candidate tokens, but drafts further outside the head's trained horizon.
# DSV41_BLOCK=5

# --- pruned all-resident mode (v0.2.0-wip; RESULTS.md 2.3/2.4). Leave empty for the full model with
# expert streaming (3-4 tok/s on a 128 GB box). PRUNE_KEEP=0.31 with the values below gives ~13 tok/s
# at +0.07 (code) / +0.19 (prose) nats teacher-forced loss vs the full model.
PRUNE_KEEP=0.44
# How the kept set is chosen: uniform (top-N per layer) or global (one cross-layer ranking under
# the same total budget; see RESULTS.md). Default uniform.
PRUNE_SELECT=
# v0.3.0-wip (RESULTS.md v0.3.0-wip): PRUNE_KEEP=0.40 with EXPERT_FORMAT=cb3 (below) is all-resident in
# 90.5 GB and measured 19.0 tok/s at -0.03/-0.17 nats vs the 0.31/fp4 row above; warm start 183 s.
TRANSIENT_SLOTS=
KEEP_FREE_GB=
# Routed-expert arena format: empty/fp4 = the checkpoint's packed FP4 (18.80 MB per expert),
# cb3 = the 3-bit per-row codebook format (14.45 MB per expert, 0.769x), packed on the GPU at warm
# start. The same ARENA_GB then holds ~31 % more experts -- 90.5 GB is 4,813 FP4 slots or 6,260 CB3
# slots, so PRUNE_KEEP=0.40 (6,160 experts, 89.0 GB) is all-resident in CB3 but not in FP4.
# Warm start is slower for it (the packing is GPU work; see NOTES.md 2026-09-11).
EXPERT_FORMAT=cb3
# exl3 = the routed experts come from a local EXL3 pack instead of the FP4 checkpoint: per-rank
# slices of the mul1 trellis (6.67 MB/expert at TP2 for a 3-bit layer, 4.46 MB for layers 18-22).
# Build the pack with tools/pack_exl3_experts.py and point DSV41_EXL3_PACK at it (default:
# <MODEL_DIR>/../exl3-packs/exl3-experts-r<rank>of<world>.bin). MODEL_DIR stays the native FP4
# checkpoint: dense, attention, head, Engram, shared experts and the FP4 DSpark drafter all still
# come from it. TP2 only in v1, and the serving path is the reference MoE until the packed
# kernels land -- treat this as a correctness/boot arm, not a speed one yet.
# EXPERT_FORMAT=exl3
# DSV41_EXL3_PACK=/home/ryan/models/exl3-packs/exl3-experts-r0of2.bin

# --- v0.4.0-wip shipped defaults (RESULTS.md v0.4.0-wip). The keep-set must be ranked on a trace
# that contains the workloads you serve: the original corpus had no markup in it and every pruned
# configuration then failed to write an HTML file.
# PRUNE_KEEP=0.44
# EXPERT_FORMAT=cb3
# ARENA_GB=98
# TRANSIENT_SLOTS=8
# KEEP_FREE_GB=6
# TRACE_STATS=results/trace-union/stats/coverage.json
# DSV41_DENSE_FP4=off
# DSV41_HEAD_FMT=bf16
# DSV41_FUSED_ATTN=0


# ======================================================================================
# ======================================================================================
# Dual DGX Spark (EP2) profile -- ACTIVE.
#
# This is the configuration the fork was developed and measured on, and the one every
# number in README.md came from. It sits at the END of the file on purpose: .env is
# sourced top to bottom, so these deliberately OVERRIDE the upstream single-box values
# above (MAX_SEQ=32768, EXPERT_FORMAT=cb3, PRUNE_KEEP=0.44, empty ARENA_GB). Those are
# left in place so this file still diffs cleanly against upstream's.
#
# Set the four site-specific values above -- PEER, MASTER_ADDR, MODEL_DIR and
# NCCL_SOCKET_IFNAME. Everything below is workload tuning, not machine tuning.
#
# Values get a line to themselves: bash strips a trailing `# comment`, but Docker
# Compose's .env parser has not always agreed, and a silently mis-parsed value here is a
# knob that looks set and is not.
# ======================================================================================
WORLD_SIZE=2
# 256k context. The indexer's score buffer caps this, not the KV cache (972 MB at 256k).
MAX_SEQ=262144
SPEC=1
# Not cb3: CB3 is ~4x slower at prefill, which long contexts cannot pay for.
EXPERT_FORMAT=fp4
# The engine clamps to 0.55 at ARENA_GB=82; higher over-subscribes the arena.
PRUNE_KEEP=0.55
ARENA_GB=82
TRANSIENT_SLOTS=16
KEEP_FREE_GB=10

# Software decode agrees with the BF16-dequant nesting control after linear-output rounding.
# dot_scaled remains an opt-in speed/quality tradeoff; see docs/gotchas.md (2026-09-14).
DSV41_FP4_DOT_SCALED=0
# Prefill-only scaled arithmetic, including bounded decoder replay. Decode is unchanged.
# Experimental; restart both ranks together and consult RESULTS.md before enabling.
DSV41_FP4_PREFILL_DOT_SCALED=0
# Native CUDA BM=16 decode kernel; enabled by default after graph microbenchmark tuning.
# Prefill and unsupported shapes continue through Triton; see docs/gotchas.md.
DSV41_FP4_CUDA=1
# Faster CUDA reduction order; set 0 for the original order. Restart both ranks together.
DSV41_FP4_CUDA_RELAXED=1
# Prefill 544 -> 1047 tok/s, and chunk-invariant, so the prefix cache still reproduces a
# cold prefill byte for byte (tools/test_prefix_invariance.py).
# Keep enabled with the nesting fix: <=128-token reference prefill remains separate.
# A stale local override to 0 roughly doubled a captured 14k-token prompt's prefill time.
DSV41_PREFILL_FUSED_ATTN=1
# Each rank reads half the Engram rows. Size-gated, so a 144-row decode gather stays
# local and only prefill-sized volumes pay for the collective.
DSV41_ENGRAM_ROW_SPLIT=1
# Native C++ gather for decode-sized (<=384 row) Engram reads; default off, needs the mmap row
# path. Measured ~+6% decode at 512 tokens on the development pair.
DSV41_ENGRAM_NATIVE=0
# Total packed row-cache MiB per node; peer inherits unless overridden.
DSV41_ENGRAM_CACHE_MB=0
# DSV41_ENGRAM_CACHE_MB_PEER=4096
DSV41_VISION=1

# --- adaptive expert residency: record what the router WANTED, re-fit the arena to it.
# Two knobs (engine/adapt_config.py); the engine derives the rest and logs what it derived.
# SENSITIVITY: off | low | medium | high | max = demand half-life never / 40 / 20 / 10 / 5
# requests, or a number s in [0, 0.5) = the newest request's share of observed demand.
# PRIOR: the shipped trace's weight, in requests.
DSV41_ADAPT_SENSITIVITY=medium
DSV41_ADAPT_PRIOR=8
# Decode-time passes every N output tokens during long answers (default 600; 0 = off).
# DSV41_ADAPT_DECODE_TOKENS=600
# Hot reads (docs/hot-reads.md): after each decode step, read the missing experts it wanted most
# (share of a row's top-6 weight >= MIN, at most MAX a step) into a RING of their own slots,
# routable from the next step until the ring wraps. Async adds no measured decode time at 0.3 / 2;
# TRANSIENT_SLOTS must hold the ring plus 8. Concurrency 1 only.
# DSV41_HOT_READS=1
# DSV41_HOT_ASYNC=1
# DSV41_HOT_MIN=0.3
# DSV41_HOT_MAX=2
# DSV41_HOT_RING=32
# With neither knob set, the legacy DSV41_PRUNE_{MISS,UNIT,PRIOR,HALFLIFE,SWAP,SWAP_MAX,
# SWAP_MIN_GAIN,SWAP_MIN_GROWTH,SWAP_MIN_GROWTH_REQ,SWAP_PREFILL,SWAP_PREFILL_MIN,
# SWAP_PREFILL_MIN_MISS} settings are read exactly as before. With a knob set they are ignored
# and named in the startup log. docs/gotchas.md explains why an aggressive half-life churns.

# --- optional instrumentation. Leave OFF for serving: the first two are host timers and
# CUDA events (cheap), but ROUTE_STATS adds two ops per layer INSIDE the decode graph.
# DSV41_STEP_TIMING=1

# Optional two-node native-FP4 tensor parallelism; see docs/tp-and-persistent-prefix.md.
# Set the same flags on both ranks. Keep the EP path by leaving these unset/0.
# DSV41_TP_EXPERTS=1
# DSV41_TP_DENSE=1
# DSV41_TP_ATTN=1
# DSV41_TP_HEAD=1
# Computed discovery before prefill, for dynamic TP2 request-unit adaptation only.
# 1 loads the selected experts before real prefill; 0 disables discovery.
# Requires post-prefill adaptation and SWA replay. No training bank.
# The ready-to-use dual-node .env.example.* profiles enable this recipe.
# DSV41_PROBE_PREFILL=1
# DSV41_PROBE_TOKENS=64
# DSV41_PROBE_FRACTION=.1
# DSV41_PROBE_TWO_PASS_BELOW=500
# Complete dot products: these are the quality-qualified defaults.
# Legacy "intermediate" splits regressed short nesting even with all experts.
# DSV41_TP_EXPERT_LAYOUT=output
# DSV41_TP_LINEAR_LAYOUT=output
# Only used by the legacy intermediate expert layout:
# DSV41_TP_EXPERT_REDUCE=auto
# Decode: run the replicated shared expert on a side CUDA stream alongside the routed experts.
# Bit-exact in the measured runs; opt-in until validated on your workloads.
# DSV41_DECODE_SHARED_OVERLAP=1
# Decode fp8 projections -- ON by default since 2026-09-23 (docs/decode-projection-fusion.md).
# All bit-exact in the TP2 full-engine A/B; together ~-3.8 ms per verify step (~4%).
# Roll back one by setting it as shown, on BOTH ranks (the boot guard compares them).
# DSV41_FP8_DECODE_BLOCK_N=128     # auto: widest tile (128/64/32/16) that fills every SM
# DSV41_FP8_DECODE_WARPS=4
# DSV41_DECODE_MERGED_PROJ=0       # one launch for wq_a||wkv and shared w1||w3, no extra memory
# DSV41_PRUNE_MISS_FUSED=0         # DSV41_PRUNE_MISS accounting in one launch per layer
# DSV41_FP8_ACT_QDQ_FUSED=0        # only matters with DSV41_ACT_QUANT=1
# Recipe default: per-step confidence-based depth 1/3/5 at every temperature.
# Sampling uses prefix decisions; greedy uses whole-block lookahead.
# Requires speculative graphed decoding (allowed above concurrency 1, not yet exercised there).
# Unset DSV41_BLOCK.
# Set CONFIDENCE=0 to restore adaptive 3/5 for all requests; for a fixed block also
# remove DYNAMIC. Measurements and scope: docs/decode-dynamic-depth.md.
DSV41_BLOCK_CONFIDENCE=1
# Default-off experiments; see docs/decode-dynamic-depth.md. The old NGRAM
# setting alone does not enable copying. Sampled copies use exact delta q.
DSV41_LOOKUP_DRAFT_ENABLED=0
DSV41_LOOKUP_DRAFT_NGRAM=16
DSV41_DRAFT_BYPASS=0
DSV41_TP_DRAFT_HEAD=0
# Set DSV41_DRAFT_HEAD_FMT=fp8 alongside TP_DRAFT_HEAD=1 for the draft-only copy.
DSV41_BLOCK_DYNAMIC=3,5
# Optional prefill FFN CUDA graphs (attention/Engram remain eager):
# DSV41_PREFILL_GRAPHS=1
# DSV41_BLOCK_DYNAMIC_START=3      # depth each request starts at
# DSV41_BLOCK_DYNAMIC_TOKENS=60    # re-decide at most once per this many output tokens

# Local persistent prefix bundles, 20 decimal GB per node, LRU-evicted.
# Token IDs/KV are sensitive; these directories must remain private and local.
# DSV41_PREFIX_DISK=1
# DSV41_PREFIX_DISK_GB=20
# DSV41_PREFIX_DISK_DIR=results/prefix-cache
# DSV41_PREFIX_SNAPSHOTS=8
# Strict=0 retains historical prefixes across adaptation, like the RAM cache.
# Strict=1 requires the exact expert mask and therefore gives fewer hits.
# DSV41_PREFIX_DISK_STRICT=0
# Skip staging and writing when every boundary is already on disk. Default on.
# DSV41_PREFIX_DISK_DEDUP=1
# DSV41_PREFILL_TIMING=1  # per-rank host/GPU chunk envelopes, reported after generation
# DSV41_GPU_TIMING=1
# DSV41_ROUTE_STATS=1
