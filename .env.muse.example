# Muse Spark on two Sparks: copy to .env.muse and adjust. Read by scripts/muse-up.sh.
# Plan, measurements and the reasoning behind each knob: docs/muse-spark-plan.md.

# Checkpoint, at the same path on both nodes (AMD's MXFP4 release: the format the expert
# kernels read; layers 0 and 61 are BF16 there and get quantized to MXFP4 at load).
MUSE_MODEL_DIR=/home/ryan/models/Muse-Spark-Open-816B-A42B-Quark-MXFP4
PORT=8000
SERVED_MODEL_NAME=muse-spark

# Context (tokens). Only the 16 full-attention layers grow: ~32 KB a token a rank, so 128K
# costs ~4.3 GB a rank of expert residency.
MUSE_MAX_SEQ=131072
# Prefill chunk; the sliding layers' ring is window (2048) + chunk.
MUSE_CHUNK=1024
# Dense weights (attention, latent expert projections, head): bf16 as published, or fp8
# (32x32 block scales; ~half the decode bytes; quality to be measured with tools/muse_nll.py).
MUSE_DENSE=bf16
# Expert slots per rank: auto = free memory after dense weights and caches, less a reserve.
MUSE_SLOTS=auto
MUSE_RESERVE_GB=12
# Experts that do not fit: substitute (router masks them; what serving uses) or stream (exact,
# loads them from disk every step; slow).
MUSE_MISS=substitute
# Resident set from a routing trace (tools/muse_trace.py writes resident-<N>.json); must
# exist at the same path on both nodes. Unset: a per-layer placeholder.
# MUSE_RESIDENT=/app/results/muse-trace-.../resident-6000.json
# Sampling defaults when a request does not set them (generation_config.json otherwise).
MUSE_DEFAULT_MAX_TOKENS=4096
MUSE_REASONING_EFFORT=medium
# DSpark drafter (Inferact/Muse-Spark-Open-DSpark), same path on both nodes; unset = none.
# Variants of the unpublished details (MUSE_DRAFT_*: see engine/muse/dspark.py DraftOptions)
# only move acceptance; tools/muse_dspark_probe.py measures them.
# MUSE_DRAFTER_DIR=/home/ryan/models/Muse-Spark-Open-DSpark
