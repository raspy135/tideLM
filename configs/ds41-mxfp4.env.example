# TideLM profile: DeepSeek-V4.1-Flash-1017, native MXFP4 experts, two Sparks (TP2), served by the
# Rust engine (rust/, scripts/rust-up.sh).
# Start: cp configs/ds41-mxfp4.env.example .env.ds41-mxfp4, edit the paths, then: scripts/tide.sh start .env.ds41-mxfp4    Stop: scripts/tide.sh stop
# README for the numbers this profile gives. Only what the Rust engine reads is here, and
# scripts/rust-up.sh lists every key with its default. The Python engine's settings
# (TIDE_ENGINE=python) are in this file as of a6ec917.

# Local paths and API. This file is private; do not commit it.
# DeepSeek-V4.1-Flash-1017 (2026-10-17): the same architecture and prompt format as V4.1-Flash,
# new weights; the original V4.1-Flash also loads from this profile with its MODEL_DIR.
MODEL_DIR=/home/you/models/DeepSeek-V4.1-Flash-1017
SERVED_MODEL_NAME=deepseek
HOST=0.0.0.0
PORT=8000
# Context a lane, generated tokens included. 1M, out of the paged pool under RUST_LANES.
MAX_SEQ=1048576
# HF_TOKEN=hf_...   (only scripts/download-model.sh needs it)

# Two-node connection. RoCE settings are detected separately on each node.
PEER=you@10.0.0.2
MASTER_ADDR=10.0.0.1
MASTER_PORT=29611
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=10.0.0.0/23
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=0

# Memory. 9,950 resident experts (64.8%) on native scales, the hot-read ring's 64 slots (below)
# and the 1M context pool (RUST_KV_TOKENS, below; the lossless scale pack, which fits more, is not
# ported). scripts/memguard.sh stops the server when MemAvailable falls below KEEP_FREE_GB. The
# same two-lane requests (2026-10-25, two fixed 512K lanes) bottomed at 6.45 / 8.00 GiB (rank 0 / 1)
# with 10,000 residents and no ring, and at 5.42 / 6.31 with 10,000 and a 128-slot ring (1.2 GB a
# rank). The ring's slots are arena slots on top of RUST_BUDGET, 9.4 MB a rank each (device memory
# 103.51 GiB at 10,000 with 64 slots, 102.95 with hot reads off, 2026-10-26), so room for a ring
# comes out of the budget: lower RUST_BUDGET as you raise DSV41_HOT_RING. The 1M pool takes
# 0.91 GiB a rank more device memory than 512K lanes paged (103.51 vs 102.60 GiB at 10,000
# residents); the README bench bottomed at 6.47 / 7.26 GiB on it against 7.75 / 7.49 (2026-10-26).
RUST_BUDGET=9950
KEEP_FREE_GB=4

# Two lanes: a second request decodes beside the first instead of queueing, and a new prompt
# prefills alone while the other lane waits; both route to the one hot-read ring. Two prose
# requests at once: 41.2 tok/s together (22.8 / 20.6 each) with the ring, 40.6 without (the same
# requests, one boot an arm). 1 serves one request at a time.
RUST_LANES=2
# Context pages (docs/paged-kv.md): both lanes' compressed caches come out of one pool of 1.5M
# tokens, so one lane reaches 1M while the other holds 512K, for 2.19 GB a rank (two fixed 512K
# lanes took 2.14). A step short of pages swaps the newest request out to the prefix disk tier
# (DSV41_PREFIX_DISK=1, required) and brings it back, exactly, once there is room. Unset, every
# lane can reach MAX_SEQ at once. Against MAX_SEQ=524288 and no pool limit (the README protocol,
# one boot an arm, 2026-10-26): prose 31.24 vs 32.17 tok/s, code 50.83 vs 48.23, the 8K prompt's
# first token 4.29 vs 4.30 s - the same speed.
RUST_KV_TOKENS=1572864

# Speculative decoding (SPEC=0: plain decode): DSpark drafts, at a depth the drafter's confidence
# picks each step (RUST_DEPTH: window, confidence or a fixed depth), behind the copy drafter, a
# CPU prompt lookup (RUST_COPY_DRAFT=0 turns it off; 2.25x on a file rewrite). Expert top-p
# (RUST_EXPERT_TOPP=0.90) measured slower: drafter acceptance fell (rust/PORT.md).
SPEC=1
RUST_DEPTH=confidence

# Adaptive expert loading: two knobs; the engine derives the rest.
# high = demand half-life 10 votes, about 5 requests (a request votes at the prefill -> decode
# boundary and again at its end). PRIOR is the shipped trace's weight, in votes.
DSV41_ADAPT_SENSITIVITY=high
DSV41_ADAPT_PRIOR=4
# Mid-answer adaptation pass every N output tokens (~0.2 s each). 0 turns only these passes off:
# the rollback if a long answer ever stalls right after a "decode adaptation" log line.
DSV41_ADAPT_DECODE_TOKENS=600
# Computed prediction: full two-pass suffix below 500 new tokens, small probe otherwise.
DSV41_PROBE_PREFILL=1
# The demand history, saved after every request; the first launch starts it from the bundled
# seed (profiles/learned-experts-v1.npz, aggregate routing counts from the development pair).
#RUST_ADAPT_DB=/home/you/tidelm-rust-state/prune_demand_rust.npz

# Hot reads (docs/hot-reads.md): after each step the heaviest misses are read from NVMe into a
# ring of DSV41_HOT_RING slots of their own while the next step runs, routable from the step after.
# Every lane's misses feed the one plan, and every lane routes to the ring. No decode cost with 128
# slots: one lane 32.36 vs 32.37 tok/s; two lanes above, with 1,002 reads over 1,265 steps, 1.1 s
# waited in all.
DSV41_HOT_READS=1
DSV41_HOT_ASYNC=1
DSV41_HOT_MIN=0.3
DSV41_HOT_MAX=2
DSV41_HOT_RING=64

# Prompts. Packed KV. The decoder SWA bounded replay: prompt rows run layers 0-20, and layers
# 20-39 replay only the prompt's last 128 rows (the 8K first token 9.30 -> 4.81 s). Prefix caching
# in RAM and on disk (the disk budget is GB per node).
DSV41_PACKED_KV=1
DSV41_SWA_REPLAY=1
DSV41_PREFIX_CACHE=1
DSV41_PREFIX_SNAPSHOTS=16
DSV41_PREFIX_DISK=1
DSV41_PREFIX_DISK_GB=20
DSV41_PREFIX_DISK_MIN_INTERVAL_S=300
DSV41_PREFIX_DISK_DEDUP=1
#RUST_PREFIX_DIR=/home/you/tidelm-rust-state/prefix-cache

# Image input; rank 1 holds the vision tower.
DSV41_VISION=1

# The abliteration overlay (README): layers 10-35's attn.wo_b from the 1017 sidecar, every other
# weight stock. A host path on both nodes; both ranks hash it into the boot guard.
#DSV41_ABLIT_WOB=/home/you/models/dsv41-1017-wo-b-ablit/wo_b_l10_35_1017.safetensors
