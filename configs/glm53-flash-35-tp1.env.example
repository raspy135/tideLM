# GLM-5.3-Flash on ONE DGX Spark (TP=1): Mia's AI Lab's EXL3 3.5bpw (Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw,
# rev 6f0cbf4a) with its non-expert weights served as FP8 (32 x 32 block scales) and 69% of the
# routed experts resident, the rest read on demand from one pack. No PEER: one box. Two Sparks:
# configs/glm53-flash-35-tp2.env.example.
# Start: cp configs/glm53-flash-35-tp1.env.example .env.glm53-flash-35, edit the paths, then
# scripts/tide.sh start .env.glm53-flash-35    Stop: scripts/tide.sh stop
#
# Setup (docs/glm-flash.md): ~160 GB of disk, nothing else downloaded
#   python3 tools/glm_fetch_dense.py --repo Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw --revision 6f0cbf4a4f1b226a20f90d715e9040a7359937f9 \
#       --out <dense dir>                                                   # 23 GB, the non-expert tensors
#   uv run --no-project --with numpy python tools/glm_pack_exl3.py --world 1 --resume --verify 64 \
#       --repo Mia-AiLab/GLM-5.3-Flash-EXL3-3.5bpw --revision 6f0cbf4a4f1b226a20f90d715e9040a7359937f9 \
#       --out <packs dir>/glm-flash-35-r0of1.bin                            # 137 GB, straight from the Hub
GLM_MODEL_DIR=/home/you/models/GLM-5.3-Flash-3.5bpw-dense
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash
GLM_MAX_SEQ=327680
# requests served at once over one paged KV pool (each lane ~0.74 GB: its KDA state 0.3, the state at
# its last prompt's end for the next turn 0.3, rollback rows 0.07)
GLM_LANES=2
GLM_LANE_CHUNK=1024
GLM_KV=fp8
GLM_KV_SPLIT=0
# a memory budget in 3-bit records at Flash's dims (9.47 MB each). 9700: 8,345 experts resident (69.0%,
# 91.9 GB); the box idles at 7.6 GiB MemAvailable (two lanes, 327,680 positions, the KV pool allocated
# whole at boot), 7.25 after bench.py - GLM-5.3's profiles serve at 6.5-7.2. Each 1 GB is ~110 slots;
# memguard stops the server under 4 GiB.
GLM_SLOTS=9700
GLM_FLASH_DENSE=fp8
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/glm-flash-packs
GLM_EXL3_PACK=/packs/glm-flash-35-r{rank}of1.bin
GLM_HEAD=exl3
GLM_KVB_FP8=1
GLM_EMBED_8BIT=int8
GLM_CHUNK=2048
GLM_PREFILL_REDUCE=bf16
# the routing history: its own state file (never GLM-5.3's), seeded at first boot from GLM_STATS_DB
RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/glm-flash-stats.npz
GLM_STATS_DB=/home/you/tidelm-rust-state/glm-flash-history-v0.npz
# the disk prefix store holds KV rows, not KDA's state: off (the engine skips it for this model)
GLM_PREFIX_DISK=0
# MTP: up to 7 drafts a round, the chain stopped on the calibrated acceptance (GLM-5.3's setting, its
# prior table learned on from Flash's own rounds). bench.py 2026-11-12, one boot an arm from the same
# state file, 9700 slots, median of 3: prose 22.12 tok/s against 20.27 for depth 3 without a gate
# (+9.1%; runs 22.07-22.28 / 20.15-20.57), code 28.15 against 28.40 (-0.9%, within its spread
# 27.67-28.64); depth 5 with the gate 21.51 / 27.81. Fewer tokens a step (prose 2.01 against 2.17)
# in cheaper rounds: the gate leaves out the rows that would be rejected.
GLM_MTP=1
GLM_MTP_DEPTH=7
GLM_MTP_CAL=0.36
GLM_MTP_DYN=0.9
GLM_COPY=1
GLM_LOOKUP=8
GLM_ADAPT=1
GLM_ADAPT_EVERY=200
GLM_ADAPT_PREFILL_SWAPS=512
GLM_ADAPT_DECODE_SWAPS=256
GLM_HOT=1
GLM_HOT_KEEP=32
GLM_HOT_ASYNC=1
GLM_BG=1
GLM_BG_EVERY=2
GLM_REASONING_EFFORT=low
GLM_DEFAULT_MAX_TOKENS=32768
# image input: the checkpoint's vision tower (1.13 GB) loaded on demand into expert slots lent for
# the request, so text-only traffic keeps the memory for experts; an image is resized to at most
# this many tokens (one a 28 x 28 pixel cell; the processor's own cap, 8000). A request carries any
# number of images: their features (8 KB a token) are allocated for its prefill, and a follow-up
# turn reuses the prefix past the images it shares with the lane's sequence
GLM_VISION=1
GLM_VISION_MAX_TOKENS=8000
