# TideLM profile: Inkling-2-Small (thinkingmachines/Inkling-2-Small, model_type inkling2) on TWO DGX Sparks
# (TP=2), served by the Rust engine (rust/crates/tidelm-glm: inkling.rs, inkling_fwd.rs; docs/inkling.md).
# Routed experts from 0xSero/Inkling-2-Small-EXL3-4bpw (rev 996dc404: EXL3 mcg, every expert at 4 bits;
# everything else the source's BF16), 18,432 of them at 16 MB: 293 GB for a pair that holds about 190.
# So residency is adaptive, as GLM-5.3's: 11,865 experts a rank (64.4%) with a 768K context.
# Start: cp configs/inkling2-small-40-tp2.env.example .env.inkling2-40-tp2, edit the paths, then
# scripts/tide.sh start .env.inkling2-40-tp2    Stop: scripts/tide.sh stop
#
#
# Setup, from the head: scripts/inkling2-setup.sh .env.inkling2-40-tp2 (--check: what is left). It
# mirrors the checkpoint (312 GB, checked by sha256), makes GLM_MODEL_DIR (17.4 GB: the non-expert
# shards, mtp.safetensors, tokenizer; hard links here, a copy on the worker) and each rank's pack
# (147.4 GB).
PEER=you@10.0.0.2
GLM_MODEL_DIR=/home/you/models/Inkling-2-Small-EXL3-4bpw-dense
PORT=8000
SERVED_MODEL_NAME=inkling-2-small

# Context. A full-attention layer (8 of the 48) keeps every position's keys and values, 4 heads a rank,
# in FP8 (GLM_INK_KV=fp8: e4m3 codes, a scale a head and position): 1,056 bytes a position a layer,
# 6.64 GB a rank at 768K, 4.43 at 512K, 2.77 at 320K (BF16, GLM_INK_KV=bf16: 2 KB, 5.37 GB at 320K). The model's
# own limit is 1M (1,048,576: 8.86 GB a rank). Held-out NLL, the two in one
# routing state (12,617 tokens): +0.0014 +- 0.0011, top-1 the same (2026-11-16). The other 40 layers
# attend 1,024 positions back and keep a BF16 ring. The position split is GLM-5.3's attention only (the
# engine refuses it here).
GLM_INK_KV=fp8
GLM_MAX_SEQ=786432
GLM_KV_SPLIT=0
# Three lanes: an agent's long conversation keeps its lane beside two other chats (with two, a pair
# of short chats evicted a 122K-token one). Each lane is ~0.4 GB a rank (its window rings, snapshots,
# the drafter's rings on rank 1). A long prompt prefills in parts; beside decoding lanes a part is
# 512 rows and the lanes then decode as long as it took (GLM_PREFILL_SHARE=0.5): a chat beside an 86K
# prefill decoded at 16.5 tok/s, 2.4 with a round a 512-row part, and waited 93 s for a whole prefill.
GLM_LANES=3
GLM_LANE_CHUNK=512

# Expert memory a rank in 3-bit records of a rank's half (6.0 MB each; this checkpoint's are all 4-bit,
# 8.0 MB): 15,800 is 94.9 GB = 11,865 experts (64.4%), with about 7.8 / 6.0 GiB of MemAvailable left idle
# on rank 0 / 1 at a 768K FP8 cache, with the vision tower, the drafter (its listed head too) and three
# lanes on rank 1 (2026-11-17). The slots are fixed, so the 768K cache's extra 2.2 GB a rank came out of
# free memory: at 15,935 rank 1 had 4.5 GiB just after boot, half a GiB over the memory guard
# (KEEP_FREE_GB 4), hence 135 fewer slots (102 experts, 0.8 GB). At 512K, 15,935 slots (11,967 experts)
# left about 9.8 / 6.6 GiB, the lowest under an 86K-token prefill beside a chat and an image request
# 9.6 / 6.6; at the BF16 cache, 16,100 slots and 320K, three lanes left rank 1 5.1. Rank 1 binds: rank 0
# has ~2 GiB more free. The bundled routing history (seed v1: a day and a night of the development
# pair's serving on top of 116K prefilled tokens of this repository's code and prose) puts 92.7% of the
# routed weight in the top 64.4% of the experts.
GLM_SLOTS=15800
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/inkling-packs
GLM_EXL3_PACK=/packs/inkling2-40-r{rank}of2.bin
# The non-expert weights as FP8 with 32 x 32 block scales (bf16: the checkpoint's own). Held-out NLL on
# corpus/heldout_quick.jsonl (12,617 tokens, one boot an arm from the same routing state, 2026-11-16):
# bf16 1.1567, fp8 1.1587 (+0.0020 +- 0.0014 paired) for 2.8 GB a rank less (7.67 -> 4.85 GB) and the
# bench 182 -> 163 s. A choice: the memory is ~350 experts' worth.
GLM_INK_DENSE=fp8

GLM_CHUNK=2048
GLM_PREFILL_REDUCE=bf16
# the routing history behind the boot placement: the engine's own, saved after every adaptation; the
# first boot starts it from the bundled seed (profiles/inkling2-history-v1.json says what it is)
RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/inkling2-40-tp2-stats.npz
GLM_STATS_DB=/app/profiles/inkling2-history-v1.npz
# Prompt prefixes on disk (GB a node): a conversation's next turn after a restart, or after another
# chat took its lane, restores instead of prefilling. A segment is the full-attention layers' rows
# (16 KB a position a rank) and, at its end, the window layers' rings and the convolutions' inputs
# (87 MB a rank), so a restore ends at a saved prompt's end. An 8.6K-token conversation after a
# restart (2026-11-16): restored in 0.07 s, first token 0.98 s where its prefill took 9.9 s.
GLM_PREFIX_DISK=1
RUST_GLM_PREFIX_DIR=/home/you/tidelm-rust-state/inkling-prefix
GLM_PREFIX_DISK_GB=60

# Speculative decoding: the model's own drafter (mtp.safetensors, "DSpark": one block pass gives 7
# drafts, the target verifies them in one pass). It runs whole on the pair's last rank (3.2 GB there in
# FP8, with its own copy of the head), from the hidden states that rank already has; its drafts are
# its top choices, kept while the gate holds. Two chat requests, greedy (2026-11-16): 24-25 -> 40-42
# tok/s, 2.4 of 2.9-3.3 drafts accepted a round; at temperature 0.6 26.8 tok/s (0.95 of 2.0: a greedy
# draft is accepted with the target's probability of it; the reference samples its drafts instead).
# Its one global layer keeps the last 16,384 positions of context (the reference: all of it, 4 KB a
# position): drafts only, the answer is the target's either way. GLM_INK_DRAFT=0: copies and lookups only.
# mtp.safetensors goes in GLM_MODEL_DIR on both nodes. The drafter's 7 steps score a listed vocabulary
# (engine/inkling_draft_vocab_ranking_v1.txt's first 65,536 ids, 0.32 GB more on rank 1) while a lane's
# recent tokens are at most 4% outside it, every id otherwise: a round 16.55 -> 11.96 ms in isolation.
# GLM_DRAFT_VOCAB=all: every id always; GLM_DRAFT_VOCAB_ROWS: the list's size (a multiple of 32).
GLM_MTP=1
GLM_MTP_DEPTH=7
GLM_MTP_CAL=0.36
GLM_MTP_DYN=0.9
GLM_COPY=1
GLM_LOOKUP=8

# Adaptive residency and hot reads, as the GLM-5.3 profiles set them (their measurements are
# GLM-5.3's; not re-measured on this model)
GLM_ADAPT=1
GLM_ADAPT_EVERY=200
GLM_ADAPT_PREFILL_SWAPS=512
GLM_ADAPT_DECODE_SWAPS=256
GLM_HOT=1
GLM_HOT_KEEP=32
GLM_HOT_ASYNC=1
# Inline rescue at 0.3 since 2026-11-18 (it was 0.4, as GLM-5.3's): the author's choice from serving
# with it; its NLL and speed have not been measured on this model.
GLM_HOT_RESCUE=0.3
GLM_BG=1
GLM_BG_EVERY=2

# Image input. The tower (23 layers, 0.65 GB of weights) is resident on the pair's last rank, which
# has the memory rank 0 lacks; that rank encodes a request's images and a gather gives both ranks the
# same features. An image is one token a 40 x 40 px cell at its own resolution (1920 x 1080: 1,296
# tokens); past GLM_VISION_MAX_TOKENS it is scaled down to fit (the tower's scratch is sized by it:
# 1.02 GB in all at 4,096). A prompt with images is not saved to the disk prefix store (a segment is
# its tokens' hash, and every image is the same placeholder). GLM_VISION=0: image parts are refused.
GLM_VISION=1
GLM_VISION_MAX_TOKENS=4096

# Answers. The template takes none / minimal / low / medium / high / xhigh / max or a number in
# [0, 0.99] ("Thinking effort level"); a request overrides it with reasoning.effort, reasoning_effort
# or chat_template_kwargs.reasoning_effort.
GLM_REASONING_EFFORT=low
GLM_DEFAULT_MAX_TOKENS=32768
# The checkpoint ships no generation_config.json: without this a request that names no top_p samples
# the whole vocabulary (top_p 1), and reads the full row back each token to do it
GLM_TOP_P=0.95
