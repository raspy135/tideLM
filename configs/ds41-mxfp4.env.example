# TideLM profile: DeepSeek-V4.1-Flash-1017, native MXFP4 experts, two Sparks (TP2).
# Start: cp configs/ds41-mxfp4.env.example .env.ds41-mxfp4, edit the paths, then: scripts/tide-up.sh .env.ds41-mxfp4    Stop: scripts/tide-down.sh
# docs/hot-reads.md for the hot-read settings; README for the numbers this profile gives.

# Local paths and API. This file is private; do not commit it.
# DeepSeek-V4.1-Flash-1017 (2026-10-17): the same architecture and prompt format as V4.1-Flash,
# new weights; the original V4.1-Flash also loads from this profile with its MODEL_DIR.
MODEL_DIR=/home/you/models/DeepSeek-V4.1-Flash-1017
PYTHON=python3
SERVED_MODEL_NAME=deepseek
HOST=0.0.0.0
PORT=8000
MAX_SEQ=524288
# One request at a time (the user's choice, 2026-10-17): one decode path, and the second lane's
# memory goes back to the arena. Async hot reads require it.
DSV41_MAX_CONCURRENCY=1
SPEC=1
DSV41_BLOCK_DYNAMIC=3,5
# Sampled drafts from the drafter's own top-p nucleus (engine/fastdecode.py::DRAFT_NUCLEUS): exact
# output distribution, code +6% (44.0 vs 41.4 tok/s), prose unchanged (docs/gotchas.md, 2026-10-21).
DSV41_DRAFT_NUCLEUS=1
DSV41_LOOKUP_DRAFT_NGRAM=6
# Overlap shared and routed experts during decode.
DSV41_DECODE_SHARED_OVERLAP=1
# HF_TOKEN=hf_...   (only scripts/download-model.sh needs it)
# Two-node connection. RoCE settings are detected separately on each node.
WORLD_SIZE=2
PEER=you@10.0.0.2
MASTER_ADDR=10.0.0.1
MASTER_PORT=29611
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=10.0.0.0/23
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=0
DSV41_PREFILL_DUAL_RAIL=1

# Expert memory budget, in GB per node.
ARENA_GB=97.4
#DSV41_RESIDENT_EXPERTS=13820

#ARENA_GB=90.2
#DSV41_RESIDENT_EXPERTS=13500

PRUNE_KEEP=0.61
TRANSIENT_SLOTS=136
KEEP_FREE_GB=6
# Keep the checkpoint's native FP4 expert weights.
EXPERT_FORMAT=fp4
#EXPERT_FORMAT=exl3
# Precision settings for normal serving.
DSV41_FP4_DOT_SCALED=0
# attn,wo_a in FP4 with the split-K kernel (docs/decode-launches.md): ~7% faster decode step, at the
# nesting-probe quality cost recorded in docs/gotchas.md. `off` reverts with no rebuild.
DSV41_DENSE_FP4=off
# Keep the drafter on the verifier's bf16 head; the fp8 draft head (tier 1) was not in the A/B.
# FP8 draft-only vocab shard + split Markov chain: -1.79 ms/step, acceptance unchanged, +2.3% tok/s
# (RESULTS.md 2026-10-08). Needs an image with the 2026-10-08 engine changes (IMAGE below).
DSV41_DRAFT_HEAD_FMT=fp8
DSV41_TP_DRAFT_HEAD=1
DSV41_DRAFT_MARKOV_TP=1
# Drafter attention split across the pair: outputs/acceptance unchanged, -1.67 ms/step (2026-10-08).
DSV41_TP_DRAFT_ATTN=1
# DSpark draft blocks' attention + shared-expert matrices from the 4-bit EXL3 draft pack
# (<MODEL_DIR's parent>/exl3-packs/exl3-draft-r{rank}of2.safetensors, on both nodes): -1.05 +- 0.37
# ms/step, outputs identical (RESULTS.md 2026-10-11). Needs TP_DRAFT_ATTN=1 and TP_LINEAR_LAYOUT=output.
# The EXL3 draft pack (exl3-packs/exl3-draft-*) was built from the old weights: read the
# checkpoint's own FP8 draft blocks instead (~1 ms a step slower).
DSV41_EXL3_DRAFT_DENSE=0
# FP8 decode schedule: 32-wide output tiles, 256-wide K tiles. Bit-identical outputs (24/24, all
# decode shapes checked), -1.47 +- 0.56 ms/step, +1.8% tok/s (RESULTS.md 2026-10-08).
DSV41_FP8_DECODE_BLOCK_N=32
DSV41_FP8_DECODE_BLOCK_K=256
# Launch fusions at fp32 rounding: one-pass RMSNorm (4 launches -> 1) and the HC mixes' mean(x^2)
# folded into the split-K projection. -2.11 +- 0.63 ms/step, acceptance +0.023 +- 0.016, +4.0% tok/s
# over 22 paired prompts (RESULTS.md 2026-10-08). 0 restores the previous kernels.
DSV41_LEAN_RMS_FUSED=1
DSV41_HC_FRONT_FUSED=1
# Split-K HC fp32 kernel, staged decode attention and the BF16-valued router gate (FP32 accumulation):
# together -7.3 ms/step, +9% tok/s, acceptance unchanged over 22 paired prompts (RESULTS.md
# 2026-10-08). The earlier one-prompt "acceptance drop" was noise. Set all three to 0 to revert.
DSV41_HC_KERNEL=1
DSV41_ATTN_STAGED=2
DSV41_ROUTER_BF16=1
# Decode-sized all-gathers over the one-shot RoCE transport (tools/roce/): -5.5 ms/step, token hashes
# identical to NCCL (docs/decode-launches.md, results/roce-20261001). Falls back to NCCL by itself on
# any setup failure; DSV41_COMM_BACKEND=nccl reverts.
DSV41_COMM_BACKEND=roce
DSV41_ROCE_MAX_KB=256
# L2 prefetch of the next layer's weights during the MoE all-gather (~0.5-1 ms); 2 MB fits RoCE's
# ~15 us window. DSV41_L2PF_MB=0 disables.
DSV41_L2PF_MB=2
# Memoize fp8->bf16 dequant for the prefill dense path (bit-identical; ~5-10% prefill, ~5 GB resident).
DSV41_DENSE_DEQUANT_CACHE=0
# Prefill performance.
DSV41_PREFILL_FUSED_ATTN=1
DSV41_PREFILL_ATTN_BLOCK_H=16
DSV41_PREFILL_ATTN_BLOCK_N=32
# Prefill kernels (2026-10-08, docs/gotchas.md). INDEXED is exact; HC_PREFILL_FUSED and
# INDEX_FUSED change numerics at the level adaptive chunk sizing already does. Cold 8K
# 7.9 -> 5.8 s together (gate, paired).
DSV41_PREFILL_ATTN_INDEXED=1
DSV41_HC_PREFILL_FUSED=1
DSV41_INDEX_FUSED=1
# Prefill-only dot_scaled experts (prompt + decoder replay; decode keeps the native kernel) on
# 32-row tiles. 8K -0.79 +- 0.14 s paired over 9 prompts; logit KL ~3x the chunk-size noise,
# top-1 unchanged 9/9; 36/36 objective probes in both arms (RESULTS.md 2026-10-08).
# Roll back with both =0 on both ranks.
DSV41_FP4_PREFILL_DOT_SCALED=1
DSV41_FP4_PREFILL_SCALED_TILES=1
# 0 = off; 1 = capture the next request. Captures contain private prompt data.
DSV41_CAPTURE_NEXT=0
# Prefix caching. Disk budget is GB per node.
DSV41_PREFIX_SNAPSHOTS=16
# 2048 rows (TF uses the same). Adaptive sizing (DSV41_PREFILL_ADAPT) still drops to 1024/512/256
# under memory pressure. 512 was set for TTS memory (Oct 7) and measured no faster once the
# Engram stalls were removed; 4096 was slower (results/prefill-trace-20261008/rows4096).
DSV41_PREFILL_CHUNK=2048
DSV41_PREFIX_DISK=1
DSV41_PREFIX_DISK_MIN_INTERVAL_S=300
DSV41_PACKED_KV=1
DSV41_PREFIX_DISK_GB=20
DSV41_PREFIX_DISK_STRICT=0
DSV41_PREFIX_RESPONSE=0

# Tensor parallelism across both nodes.
DSV41_TP_EXPERTS=1
DSV41_TP_DENSE=1
DSV41_TP_ATTN=1
DSV41_TP_HEAD=1
DSV41_TP_DRAFT_EXPERTS=1
DSV41_TP_EMBED=1
DSV41_TP_EXPERT_REDUCE=auto
DSV41_TP_EXPERT_LAYOUT=output
DSV41_TP_LINEAR_LAYOUT=output

# Adaptive expert loading: two knobs (engine/adapt_config.py); the engine derives the rest.
# high = demand half-life 10 requests. PRIOR is the shipped trace's weight, in requests.
DSV41_ADAPT_SENSITIVITY=high
DSV41_ADAPT_PRIOR=4
# Mid-answer adaptation pass every N output tokens (~0.2 s each). 0 turns only these passes off:
# the rollback if a long answer ever stalls right after a "decode adaptation" log line.
DSV41_ADAPT_DECODE_TOKENS=600
# Legacy settings below: used only by images built before the knobs existed. A new image
# ignores them (and names them in the startup log). Delete them once the rebuild is running.
DSV41_PRUNE_MISS=1
# Request-based demand. PRIOR and HALFLIFE are measured in requests.
DSV41_PRUNE_UNIT=request
DSV41_PRUNE_PRIOR=4
# 1017's own demand history, seeded 2026-10-18 from the old model's (docs/gotchas.md "The old
# model's demand history costs 1017 0.35 nats on prose"); adaptation re-ranks it from here.
DSV41_PRUNE_DB=results/prune_demand_req_score_1017.npz
DSV41_ENGRAM_ROW_SPLIT=1
# Native C++ gather for decode-sized (<=384 row) Engram reads. Code default is 0;
# measured +6.2% at 512 tokens (order-balanced A/B), read_s 2.4 -> 0.3 s. Requires
# the mmap row path, which is on by default. Roll back with =0 on both ranks.
DSV41_ENGRAM_NATIVE=1
# O_DIRECT sector reads for prefill-sized Engram gathers (> 384 rows); decode keeps the memmap.
# Page-faulted prefill reads forced reclaim/compaction that stalled the GPU: cold 8K
# 358-545 -> 782-933 tok/s. All-sizes (=1) cost decode +0.9 ms/step.
DSV41_ENGRAM_DIRECT=prefill
# Enable expert swaps after requests.
DSV41_PRUNE_SWAP=1
DSV41_PRUNE_SWAP_MAX=512
DSV41_PRUNE_SWAP_MIN_GROWTH=0
DSV41_PRUNE_SWAP_MIN_GAIN=0.002
DSV41_PRUNE_SWAP_PREFILL=1
DSV41_PRUNE_SWAP_PREFILL_MIN=32
# Minimum prefill miss rate before swapping experts.
DSV41_PRUNE_SWAP_PREFILL_MIN_MISS=0.02
DSV41_PRUNE_HALFLIFE=10
# Peer keepalive interval, in seconds.
DSV41_EP_PING_S=30
# Image support.
DSV41_VISION=1

DSV41_FP4_CUDA=1
# moe_down with two output rows a warp (tools/fp4_moe_cuda.cu::moe_down_bm16_v3): same bits as v2,
# down 358 -> 323 us a call, greedy python 77.4 -> 75.8 ms/step (docs/gotchas.md, 2026-10-21).
DSV41_FP4_CUDA_DOWN_ROWS=2

# Optional native FP8 L10-35 attn.wo_b overlay (engine/ablit.py); empty = stock.
# 1017: drowzeys/keys-DeepSeek-V4.1-Flash-1017-Abliterated (README download instructions).
# Download the SAME file on both nodes under MODEL_DIR's parent; use its CONTAINER path:
# DSV41_ABLIT_WOB=/models/dsv41-1017-wo-b-ablit/wo_b_l10_35_1017.safetensors
# The old wo_b_l10_35.safetensors is for the original V4.1-Flash only, never 1017.
# Do not use the EXL3 sidecars: this profile loads native FP8 attention.
DSV41_ABLIT_WOB=
# Per-step verification depth 1/3/5 at every temperature, including sampled requests.
DSV41_BLOCK_CONFIDENCE=0
# The image scripts/dual-build.sh builds (README, Quick start step 3); both engines run from it.
IMAGE=tidelm:local
DSV41_ENGRAM_CACHE_MB=256
DSV41_ENGRAM_CACHE_MB_PEER=256
DSV41_PREFILL_GRAPHS=0
DSV41_PRUNE_METRIC=score

# Keep selective prefill streaming off until contribution calibration shows a quality gain.
DSV41_CRITICAL_PREFILL=0
DSV41_STREAM_LAYERS=
DSV41_LAYER_ABLATION_FILE=
DSV41_PRUNE_LAYER_COUNTS=''

DSV41_USER_PROMPT_STREAM=0

DSV41_PREFIX_CACHE=1

DSV41_SWA_REPLAY=1

DSV41_DYNAMIC_EXPERTS=1

DSV41_USER_PROMPT_MAX_LOADS=100

DSV41_PRUNE_LAYER_WEIGHTS=''
DSV41_VISION_MODE=peer

# Computed prediction: full two-pass suffix below 500 new tokens, small probe otherwise.
DSV41_PROBE_PREFILL=1
DSV41_PROBE_TOKENS=64
DSV41_PROBE_FRACTION=.1
DSV41_PROBE_TWO_PASS_BELOW=500

DSV41_ROUTER_FUSED_TAIL=1

DSV41_GRAPHS_MAX=8

DSV41_PREFILL_ADAPT=1

DSV41_PREFILL_FLOOR_GIB=4

DSV41_PREFILL_MIN_ROWS=256

DSV41_PREFILL_ROW_MIB=2

DSV41_L2PF_MODE=touch

DSV41_L2PF_PACE_GBPS=0

DSV41_L2PF_ATTN_MB=4

DSV41_CONF_COST_REFRESH=0
DSV41_HEAD_KERNEL=packed

DSV41_EXPERT_TOPP=0.90
# The drafter scores 40,960 listed ids a rank (docs/draft-vocab.md); the file ships in the image.
DSV41_DRAFT_VOCAB=/app/engine/draft_vocab_ranking_v1.txt
DSV41_DRAFT_VOCAB_ROWS=40960

DSV41_PREFIX_DISK_DEDUP=1


# DeepSeek-V4.1-Flash-1017 and hot reads
# Hot reads, async (docs/hot-reads.md): +0.3% tok/s on the gate, -0.0074 / -0.138 nats held-out
# NLL on code / prose. The ring's 128 slots come out of the transient ring (8 + 128).
DSV41_HOT_READS=1
DSV41_HOT_ASYNC=1
DSV41_HOT_MIN=0.3
DSV41_HOT_MAX=2
DSV41_HOT_RING=128
