# TideLM profile: GLM-5.3, EXL3 experts, two Sparks (TP2), served by the Rust engine
# (rust/crates/tidelm-glm, scripts/rust-up.sh).
# Start: cp configs/glm53-exl3.env.example .env.glm53-exl3, edit the paths, then: scripts/tide-up.sh .env.glm53-exl3    Stop: scripts/tide-down.sh
# README for the numbers this profile gives. Only what the Rust engine reads is here:
# scripts/rust-up.sh maps each GLM_* key to its flag, with its default, and refuses the choices it
# does not implement rather than serve something else. The Python engine's settings
# (TIDE_ENGINE=python) are in this file as of a6ec917. Measurements marked Python were taken on
# that engine, at the settings this one runs.

PEER=you@10.0.0.2
# Checkpoint at the same path on both nodes.
GLM_MODEL_DIR=/home/you/models/GLM-5.3-EXL3-3.0bpw
PORT=8000
SERVED_MODEL_NAME=glm-5.3

# Context. The MLA latent cache in FP8, split across the ranks: 256K is 7.3 GB a rank. The FP4/FP8
# mix (Python's GLM_KV=fp4) fit 320K in less, at KL +0.004 on the long eval, but in use the model's
# recall of its context was visibly worse (2026-10-20); this engine serves FP8.
GLM_MAX_SEQ=262144
# FP8 KV cache: +0.002-0.005 NLL over BF16 and half its memory (~900 EXL3 slots at 128K).
GLM_KV=fp8
# Each rank caches every other position (docs/gotchas.md): half the KV memory, decode at parity.
GLM_KV_SPLIT=1

# Expert slots per rank. Quality follows residency: Tokyo 3-row eval KL 0.171 at 7,000 -> 0.132
# at 8,500 -> 0.113 at 9,394 (MXFP4 slots). 12,500 EXL3 slots (7.1 MB each, 65.1% of the decoder
# layers' routed experts): the README run bottomed at 9.6 / 11.3 GiB MemAvailable (rank 0 / 1).
# Rank 0 binds (it runs the HTTP server); each 1 GB is ~140 slots. A leaking service on either
# node costs the pair (rank 1's polkitd once held 4.7 GB, fed by a dashboard's ssh login a poll).
GLM_SLOTS=12500
# Routed experts in EXL3 3-bit (bertholomus/GLM-5.3-EXL3-3.0bpw, packed per rank by
# tools/glm_pack_exl3.py, README). Dense and fixed weights come from GLM_MODEL_DIR too; the MTP
# routed experts use their published 4-bit EXL3 pack records. GLM_EXL3_PACK's /packs is
# GLM_EXL3_DIR.
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/glm-exl3-packs
GLM_EXL3_PACK=/packs/glm-exl3-experts-r{rank}of2.bin
# The checkpoint publishes MLA's absorbed kv_b in FP16; it is quantized at load to FP8 with
# Quark's 128x128 blocks: decode's absorbs 72-83 -> 43-45 us a layer, 0.58 GB a rank less
# (docs/glm53-native-exl3.md). The INT8 embedding is converted from this checkpoint's own.
GLM_KVB_FP8=1
GLM_EMBED_8BIT=int8

# Prefill. 4,096-row chunks: 8K prompt 18.9 -> 17.8 s (Python) for ~1 GB more transient memory
# during a prefill (2026-10-20, docs/gotchas.md); 2,048 holds that GB back.
GLM_CHUNK=4096
# A prefill chunk's attention partials summed over the ranks in BF16 instead of fp32 (or fp32):
# 8K prompt 0.75 s less attention time (Python), one BF16 step on each layer's attention output;
# against the fp32 sum, every expert exact, long set: KL 0.014 / top-1 97.3%, the same as a
# one-bit control (docs/gotchas.md 2026-10-20).
GLM_PREFILL_REDUCE=bf16
# Prefill a new message of 4-512 tokens twice, loading what it routes to in between: Japanese
# turns against every expert exact, EXL3 KL 0.096 -> 0.074 and 0.110 -> 0.084 (a new topic on a
# cached conversation), +1-3 s to the first token.
GLM_PREFILL_TWO_PASS=512
# ... unless the first pass computed less than this share of the new tokens' routed weight on
# substitutes. Measured 2026-10-20 at 12,000 EXL3 slots: fresh topics missed 27-41% in their first
# pass, follow-up turns on a settled conversation 12-14%, and the second pass costs 1-3 s of first
# token; its quality gain was measured at the fresh-topic miss rates, not at 12-14%.
GLM_PREFILL_TWO_PASS_MISS=0.15
# Prompt prefixes on disk: another chat or Open WebUI's title/tag requests no longer cost a long
# conversation's next turn a full prefill (GB a node).
GLM_PREFIX_DISK=1
GLM_PREFIX_DISK_GB=20

# MTP speculative decoding (GLM_MTP=0: off), up to GLM_MTP_DEPTH drafts a round.
GLM_MTP=1
GLM_MTP_DEPTH=7
# The chain stops on the calibrated acceptance: a table of measured acceptance by draft position
# and stated chain probability, threshold at a verify row's break-even (the MTP's own product is
# optimistic 2-3x at depth). Python, bench.py 2026-10-23, same prompts, one boot an arm: code 20.24
# tok/s at 3.42 drafts a round against the flat 0.9 gate's 19.60, prose 15.31 against 15.10 (the
# code gain is the size of the noise). Per-position thresholds on the stated probability
# (0.7,0.5,0.2,0.1,0.05) measured worse on the same run: 17.86 / 13.29, the rows they add worth
# 4-17 tok/s in an 18-15 tok/s round. GLM_MTP_CAL=0 runs the flat gate, GLM_MTP_DYN.
GLM_MTP_CAL=0.36
GLM_MTP_DYN=0.9
# Copy rounds: once the last 8 tokens repeat earlier text in the prompt or answer, a round verifies
# that text's continuation instead of MTP drafts: same rows, no draft passes, exact at any
# temperature. Python, one boot, interleaved, greedy: rewriting a 200-line file 27.8 -> 33.8 tok/s
# (6.9 of 7 copied drafts accepted), re-running a tool call 25.3 -> 33.2, prose 13.3 -> 14.2 with no
# copy rounds (the drift, ~+6%, is in all three).
GLM_LOOKUP=8

# Expert adaptation: always once after prefill (before the first decode step), then every
# GLM_ADAPT_EVERY generated tokens; swaps capped per adaptation. 512 after prefill: 2,048 cost
# 1.7 s more TTFT on a 3.3K prompt for the same decode miss (36.2% vs 36.3%).
GLM_ADAPT=1
GLM_ADAPT_EVERY=200
GLM_ADAPT_PREFILL_SWAPS=512
GLM_ADAPT_DECODE_SWAPS=256
# Hot misses: per layer, the heaviest missed pick with router weight share >= 0.2 is read now,
# computed exactly, and kept resident over a cold, lowest-ranked victim (GLM_HOT_KEEP victims
# queued a period); at most 16 reads a step, paced evenly over the layers (by the i-th of n MoE
# layers, at most ceil(16 * (i+1)/n)). The threshold, cap and pacing are fixed at the best row of
# the Python measurement, Tokyo eval in 3-row (MTP depth 2) steps, KL to exact / top-1, tok/s:
#   target-4 controller, bg 8, not kept   0.299 / 86.4%   10.7
#   0.2, cap 10, first come, kept         0.235 / 88.7%    9.19
#   0.2, cap 10, paced, kept              0.212 / 89.9%    9.29
#   0.2, cap 12, paced, kept              0.189 / 89.2%    9.03
#   0.2, cap 16, paced, kept              0.171 / 90.9%    8.95
#   0.2, no cap, kept                     0.172 / 90.3%    8.24
#   0.15, cap 16, paced, kept             0.194 / 90.1%    -- (1.8x the reads; light misses churn residents)
#   0.25, cap 10, kept                    0.257 (one-row)  10.39
GLM_HOT=1
GLM_HOT_KEEP=32
# Background period: every 2 rounds rank 0 plans the victims kept hot reads replace. Nothing else
# is read in the background: next to kept hot reads, background reads cost speed for little (8
# reads, 0.2 uncapped, kept: 7.9 tok/s KL 0.152 vs none + cap 10: 9.19 tok/s KL 0.164, one-row
# eval), and prefill prefetch took a 3.3K prompt's prefill miss 33% -> 25% but TTFT 23.7 -> 32.8 s,
# decode miss unchanged.
GLM_BG=1
GLM_BG_EVERY=2
# The routing history behind the boot placement is the engine's own, saved after every
# adaptation; the first boot starts it from the bundled seed (profiles/glm53-experts-v1.pt: 2.3M
# tokens of the author's routing, see its .json).
#RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/glm-stats-rust.npz
#RUST_GLM_PREFIX_DIR=/home/you/tidelm-rust-state/glm-prefix

# Answers. GLM's template knows low / high; anything else (the server's own default, medium)
# renders "Reasoning Effort: Max". Low keeps chat answers short. A request overrides it with
# reasoning.effort, reasoning_effort or chat_template_kwargs.reasoning_effort (first wins).
GLM_REASONING_EFFORT=low
# Reply cap when the request sends no max_tokens (Open WebUI doesn't); clamped to the context
# left, so in effect "until the context is full" (DS V4.1's default too). 4096 cut off HTML
# pages with their reasoning. The KV cache is sized by GLM_MAX_SEQ, not by this.
GLM_DEFAULT_MAX_TOKENS=131072
# A cycle of 1-8 tokens about to repeat a 12th time: that token is excluded and the next one
# drawn again (docs/gotchas.md: substituted experts open repetition loops; the model holds them).
GLM_LOOP_BREAK=12
